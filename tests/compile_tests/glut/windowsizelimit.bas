$IF WINDOWS OR MACOSX THEN
    ' GLFW cannot create a window with OpenGL context in a macOS and Windows GitHub runner
    $CONSOLE:ONLY
    PRINT _TRUE
    SYSTEM
$END IF

$CONSOLE
_DEST _CONSOLE

_WINDOWSIZELIMIT
_WINDOWSIZELIMIT (320, 240)
_WINDOWSIZELIMIT - (800, 600)
_WINDOWSIZELIMIT -(800, 600)
_WINDOWSIZELIMIT (320, 240) - (800, 600)
_WINDOWSIZELIMIT (320, 240)-(800, 600)

PRINT _TRUE
SYSTEM
