'--- This function simulates the open behavior of real files depending
'--- on the file OPEN mode. That way the file OPEN calls are easily
'--- replaceable by OpenBuffer&() calls without worry about the internal
'--- differences of the buffer system compared to real files.
'--- Respective CLOSE calls can be simply removed as buffers remain
'--- always accessible until cleared/disposed.
'-----
'--- The file names given to this function should be just the same as
'--- you would use to open a real file, i.e. inclusive full or relative
'--- path as required.
'--- Modes names can be short, only the first character is checked.
'---------------------------------------------------------------------
FUNCTION OpenBuffer& (sbMode$, sbName$)
    '--- option _explicit requirements ---
    DIM buf&, nul&, known&, newUb&, mode$
    '--- buffer already existing? ---
    IF LEN(sbName$) > 0 THEN
        known& = SBufNFind&(sbName$)
        IF known& < 0 THEN buf& = UBOUND(SBufN) + 1 ELSE buf& = known&
    ELSE
        ' An empty sbName$ means grab the first unnamed buffer
        FOR buf& = 0 TO UBOUND(SBufN)
            IF SBufN(buf&) = sbName$ THEN EXIT FOR
        NEXT buf&
    END IF
    mode$ = UCASE$(LEFT$(sbMode$, 1))
    '--- Retired buffers are no longer in memory even though the backing file
    '--- has contents, so opening them for anything other then "O" is invalid.
    '-----
    '--- This reports an "UNEXPECTED INTERNAL COMPILER ERROR!"; run with
    '--- QB64PE_LOG_HANDLERS=console QB64PE_LOG_LEVEL=error to see which file
    '--- and which mode.
    IF buf& <= UBOUND(SBufN) THEN
        IF SBufRetired(buf&) AND mode$ <> "O" THEN
            _LogError "Buffer for " + sbName$ + " was retired, it cannot be reopened in mode " + mode$
            ERROR 258: STOP 'invalid handle
        END IF
    END IF
    '--- simulate file modes ---
    SELECT CASE mode$
        CASE "A" 'append
            IF buf& > UBOUND(SBufN) THEN GOSUB newBuf
            nul& = SeekBuf&(buf&, 0, SBM_BufEnd)
        CASE "B" 'binary
            IF buf& > UBOUND(SBufN) THEN GOSUB newBuf
            nul& = SeekBuf&(buf&, 0, SBM_BufStart)
        CASE "I" 'input (try to load from file, if yet unknown)
            IF buf& > UBOUND(SBufN) THEN GOSUB loadBuf
            nul& = SeekBuf&(buf&, 0, SBM_BufStart)
        CASE "O" 'output
            IF buf& <= UBOUND(SBufN) THEN DisposeBuf buf&: SBufNUnindex buf&: SBufN(buf&) = "": SBufRetired(buf&) = 0
            GOSUB newBuf
        CASE ELSE 'random or unknown mode
            buf& = SBE_NoMoreBuffers 'not supported
    END SELECT
    OpenBuffer& = buf&
    EXIT FUNCTION
    '----------
    newBuf:
    buf& = CreateBuf&: ConvBufToNativeEol buf&
    GOSUB growLists
    SBufN(buf&) = sbName$: SBufNIndex buf&
    SBufRetired(buf&) = 0
    RETURN
    '----------
    loadBuf:
    buf& = FileToBuf&(sbName$): ConvBufToNativeEol buf&
    GOSUB growLists
    SBufN(buf&) = sbName$: SBufNIndex buf&
    SBufRetired(buf&) = 0
    RETURN
    '----------
    growLists:
    IF buf& > UBOUND(SBufN) THEN
        newUb& = UBOUND(SBufN) + (UBOUND(SBufN) + 1) \ 2
        IF newUb& < buf& + 99 THEN newUb& = buf& + 99 'at least 100 more buffers
        'Never grow the list past the buffer cap: CreateBuf& cannot hand out a handle above it,
        'and this keeps UBOUND(SBufN) + 1 (the "not found" handle used above) and the 1.5x
        'growth step well inside the LONG range.
        IF newUb& > simplebuffer_maxBufs THEN newUb& = simplebuffer_maxBufs
        REDIM _PRESERVE SBufN(0 TO newUb&) AS STRING
        REDIM _PRESERVE SBufCppLineStatus(0 TO newUb&) AS _Byte
        REDIM _PRESERVE SBufRetired(0 TO newUb&) AS _Byte
        REDIM _PRESERVE SBufNHashNext(0 TO newUb&) AS LONG
    END IF
    RETURN
END FUNCTION

'--- Hash of a buffer name. We use the length along with the first and
'--- last 12 characters.
'---------------------------------------------------------------------
FUNCTION SBufNHash& (sbName$)
    '--- option _explicit requirements ---
    DIM h&, idx&, l&
    l& = LEN(sbName$)
    h& = l&
    IF l& > 24 THEN
        FOR idx& = 1 TO 12
            h& = ((h& * 31) XOR ASC(sbName$, idx&)) AND SBufNHashMask
        NEXT idx&
        FOR idx& = l& - 11 TO l&
            h& = ((h& * 31) XOR ASC(sbName$, idx&)) AND SBufNHashMask
        NEXT idx&
    ELSE
        FOR idx& = 1 TO l&
            h& = ((h& * 31) XOR ASC(sbName$, idx&)) AND SBufNHashMask
        NEXT idx&
    END IF
    SBufNHash& = h&
END FUNCTION

'--- Returns the handle of the buffer named sbName$, or -1 if there is none.
'---------------------------------------------------------------------
FUNCTION SBufNFind& (sbName$)
    '--- option _explicit requirements ---
    DIM i&
    SBufNFind& = -1
    IF LEN(sbName$) = 0 THEN EXIT FUNCTION
    i& = SBufNHashTable(SBufNHash&(sbName$))
    WHILE i&
        IF SBufN(i& - 1) = sbName$ THEN SBufNFind& = i& - 1: EXIT FUNCTION
        i& = SBufNHashNext(i& - 1)
    WEND
END FUNCTION

'--- Adds the (already assigned) name of buffer buf& to the hash table.
'---------------------------------------------------------------------
SUB SBufNIndex (buf&)
    '--- option _explicit requirements ---
    DIM h&
    IF LEN(SBufN(buf&)) = 0 THEN EXIT SUB
    h& = SBufNHash&(SBufN(buf&))
    SBufNHashNext(buf&) = SBufNHashTable(h&)
    SBufNHashTable(h&) = buf& + 1
END SUB

'--- Removes buffer buf& from the hash table, to be called while SBufN(buf&) still
'--- holds the name it was inserted under.
'---------------------------------------------------------------------
SUB SBufNUnindex (buf&)
    '--- option _explicit requirements ---
    DIM h&, i&, prev&
    IF LEN(SBufN(buf&)) = 0 THEN EXIT SUB
    h& = SBufNHash&(SBufN(buf&))
    i& = SBufNHashTable(h&)
    WHILE i&
        IF i& - 1 = buf& THEN
            IF prev& THEN
                SBufNHashNext(prev& - 1) = SBufNHashNext(buf&)
            ELSE
                SBufNHashTable(h&) = SBufNHashNext(buf&)
            END IF
            SBufNHashNext(buf&) = 0
            EXIT SUB
        END IF
        prev& = i&
        i& = SBufNHashNext(i& - 1)
    WEND
END SUB

'--- This subroutine will clear the given buffer or ALL buffers, if the
'--- name argument is empty.
'--- Clearing a buffer is the equivalent to KILLing a real file.
'-----
'--- To designate a single buffer to clear, use the same file name as
'--- given at the respective OpenBuffer&() call.
'---------------------------------------------------------------------
SUB ClearBuffers (sbName$)
    '--- option _explicit requirements ---
    DIM buf&
    '--- clear/dispose buffer(s) ---
    IF sbName$ <> "" THEN
        FOR buf& = 0 TO UBOUND(SBufN)
            IF SBufN(buf&) = sbName$ THEN EXIT FOR 'buffer found
        NEXT buf&
        IF buf& > UBOUND(SBufN) THEN EXIT SUB 'buffer doesn't exist
        DisposeBuf buf&: SBufNUnindex buf&: SBufN(buf&) = ""
        SBufCppLineStatus(buf&) = 0: SBufRetired(buf&) = 0
    ELSE
        FOR buf& = 0 TO UBOUND(SBufN)
            IF SBufN(buf&) <> "" THEN DisposeBuf buf&: SBufNUnindex buf&: SBufN(buf&) = ""
            SBufCppLineStatus(buf&) = 0: SBufRetired(buf&) = 0
        NEXT buf&
    END IF
END SUB

'--- Clears one buffer, given its handle rather than its name.
'--- This is a lot faster than ClearBuffers() if we still have a handle to the
'--- file.
'---------------------------------------------------------------------
SUB ClearBufferAt (buf&)
    IF LEN(SBufN(buf&)) = 0 THEN EXIT SUB
    DisposeBuf buf&: SBufNUnindex buf&: SBufN(buf&) = ""
    SBufCppLineStatus(buf&) = 0: SBufRetired(buf&) = 0
END SUB

'--- This subroutine will write the current contents of the given buffer
'--- or ALL buffers, if the name argument is empty, into the respective
'--- files on disk (using names as given by the OpenBuffer&() function)
'--- The change state of the buffer(s) is checked first to avoid needless
'--- disk writes.
'-----
'--- To designate a single buffer to write, use the same file name as
'--- given at the respective OpenBuffer&() call.
'---------------------------------------------------------------------
SUB WriteBuffers (sbName$)
    '--- option _explicit requirements ---
    DIM buf&
    '--- write buffer(s) ---
    IF sbName$ <> "" THEN
        FOR buf& = 0 TO UBOUND(SBufN)
            IF SBufN(buf&) = sbName$ THEN EXIT FOR 'buffer found
        NEXT buf&
        IF buf& > UBOUND(SBufN) THEN EXIT SUB 'buffer doesn't exist
        IF NOT SBufRetired(buf&) THEN WriteBufferAt buf&
    ELSE
        FOR buf& = 0 TO UBOUND(SBufN)
            IF SBufN(buf&) <> "" THEN
                '--- Retired buffers have already been written out ---
                IF NOT SBufRetired(buf&) THEN WriteBufferAt buf&
            END IF
        NEXT buf&
    END IF
END SUB

'---------------------------------------------------------------------
'--- Writes one buffer to its file, but only if the bytes differ from
'--- what the file already holds.
'---------------------------------------------------------------------
SUB WriteBufferAt (buf&)
    IF IsBufChanged%(buf&) _ANDALSO NOT BufMatchesFile%(buf&, SBufN(buf&)) THEN BufToFile buf&, SBufN(buf&)
END SUB

'---------------------------------------------------------------------
'--- Writes a buffer out and hands its memory back, for a file that is
'--- complete and will not be added to again. Pass discard% to throw the
'--- contents away instead of writing them. The buffer itself is still kept in
'--- SBufN() and its metadata is kept around.
'---------------------------------------------------------------------
SUB RetireBuffer (buf&, discard%)
    '--- option _explicit requirements ---
    DIM b&
    '--- check handle ---
    IF NOT CheckHandle%(buf&) THEN ERROR 258: STOP 'invalid handle
    IF NOT discard% THEN WriteBufferAt buf&
    b& = buf& * simplebuffer_slots
    simplebuffer_array$(b& + 0) = ""
    '--- cursor back to the start and nothing pending, so that the buffer
    '--- describes itself honestly even though it holds nothing
    MID$(simplebuffer_array$(b& + 1), 1, 4) = MKL$(1)
    MID$(simplebuffer_array$(b& + 1), 13, 4) = MKL$(0)
    SBufRetired(buf&) = -1
END SUB

'---------------------------------------------------------------------
'--- Retires the buffer of the named file, if there is one.
'---------------------------------------------------------------------
SUB RetireBufferNamed (sbName$, discard%)
    '--- option _explicit requirements ---
    DIM buf&
    buf& = SBufNFind&(sbName$)
    IF buf& < 0 THEN EXIT SUB 'buffer doesn't exist
    RetireBuffer buf&, discard%
END SUB

'---------------------------------------------------------------------
'--- Tells whether a buffer's contents are already what the given file
'--- holds, allowing a write can be skipped. Compares the same bytes
'--- BufToFile() would write, and checks the length before reading, so
'--- a file of a different size costs no read at all.
'---------------------------------------------------------------------
FUNCTION BufMatchesFile% (handle&, fileSpec$)
    '--- option _explicit requirements ---
    DIM buf&, ff%, bl&, ofs&, n&, dat$
    '--- check handle ---
    IF NOT CheckHandle%(handle&) THEN ERROR 258: STOP 'invalid handle
    '--- nothing to compare against ---
    IF NOT _FILEEXISTS(fileSpec$) THEN EXIT FUNCTION
    buf& = handle& * simplebuffer_slots
    bl& = GetBufLen&(handle&)
    ff% = FREEFILE
    OPEN fileSpec$ FOR BINARY LOCK WRITE AS ff%
    IF LOF(ff%) = bl& THEN
        BufMatchesFile% = -1
        ofs& = 1
        DO WHILE ofs& <= bl&
            n& = bl& - ofs& + 1
            IF n& > BufCompareChunkSize THEN n& = BufCompareChunkSize
            IF LEN(dat$) <> n& THEN dat$ = SPACE$(n&)
            GET ff%, ofs&, dat$
            IF dat$ <> MID$(simplebuffer_array$(buf& + 0), ofs&, n&) THEN
                BufMatchesFile% = 0
                EXIT DO
            END IF
            ofs& = ofs& + n&
        LOOP
    END IF
    CLOSE ff%
END FUNCTION

' This is the directory that the user's main source file lives, and thus the
' path where all other debug paths are made relative too (so when the debugger
' is run from that location, paths can be resolved).
FUNCTION DebugPathBase$
    IF LEN(path.source$) THEN
        DebugPathBase$ = path.source$
    ELSE
        'path.source$ is empty when the source was given without a directory
        DebugPathBase$ = getfilepath$(_FULLPATH$(sourcefile$))
    END IF
END FUNCTION

' Resolves the path used for a source file in embedded debug info (#line entries).
'
' When AbsoluteDebugPaths is set, all paths are resolved to be absolute paths
' to that file on this machine. This is the simplest form to ensure the path
' will always be resolved correctly by a debugger, but it is not portable (the
' absolute paths won't be correct on another machine).
'
' When not set, we resolve all file paths for the user's program relative to
' the main source location.  Internal files remain relative to the QB64-PE
' source (and we can detect them via the 'internal' or 'libraries' location
' they will have). A debugger can then be given those locations to look at for
' resolving the source files.
FUNCTION ResolveDebugPath$ (path$, isInternal As Long)
    DIM fixedPath AS STRING

    'The auto-included support files are named with "\" separators no matter the
    'platform, and $INCLUDE paths come straight from the user, so neither is
    'guaranteed to use the separator a debugger (or MakeRelativePath$) expects
    fixedPath = path$
    PATH_SLASH_CORRECT fixedPath

    IF AbsoluteDebugPaths THEN
        ResolveDebugPath$ = _FULLPATH$(fixedPath)
    ELSEIF isInternal THEN
        ResolveDebugPath$ = fixedPath
    ELSE
        ResolveDebugPath$ = MakeRelativePath$(DebugPathBase$, _FULLPATH$(fixedPath))
    END IF
END FUNCTION

SUB AddCppLine (buf As LONG)
    DIM incName AS STRING
    DIM lineNum AS LONG
    DIM isInternal AS LONG

    IF inclinenumber(inclevel) THEN
        lineNum = inclinenumber(inclevel)
        incName = incname$(inclevel)
        isInternal = incIsInternal(inclevel)
    ELSE
        lineNum = linenumber
        incName = sourcefile$
        isInternal = _FALSE
    END IF

    ' We cache the current #line entry because it's fairly expensive to
    ' produce when accounting for _FULLPATH or MakeRelativePath().
    '
    ' Source files are processed linearly so caching a single entry is fine,
    ' once we're done with one we usually won't need it again.
    IF LEN(AddCppLine_suffix) = 0 OR incName <> AddCppLine_name OR _
       isInternal <> AddCppLine_internal OR AbsoluteDebugPaths <> AddCppLine_absolute OR _
       sourcefile$ <> AddCppLine_source OR path.source$ <> AddCppLine_base THEN
        AddCppLine_name = incName
        AddCppLine_internal = isInternal
        AddCppLine_absolute = AbsoluteDebugPaths
        AddCppLine_source = sourcefile$
        AddCppLine_base = path.source$
        AddCppLine_suffix = " " + CHR$(34) + GetEscapedPath$(ResolveDebugPath$(incName, isInternal)) + CHR$(34)
    END IF

    'line 0 is out of range for the C preprocessor, which we can end up with
    'before the first line of the program has been read
    IF lineNum < 1 THEN lineNum = 1

    WriteBufLine buf, "#line " + _TOSTR$(lineNum) + AddCppLine_suffix
END SUB

SUB WriteBufLineCpp (buf As Long, s as String)
    IF NOT SBufCppLineStatus(buf) THEN
        AddCppLine buf
    ELSE
        SBufCppLineStatus(buf) = _FALSE
    END IF
    WriteBufLine buf, s
END SUB

SUB WriteBufRawDataCpp (buf AS LONG, s AS STRING)
    IF NOT SBufCppLineStatus(buf) THEN
        AddCppLine buf
        SBufCppLineStatus(buf) = _TRUE
    END IF
    WriteBufRawData buf, s
END SUB
