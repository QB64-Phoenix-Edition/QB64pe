'INI Manager v2.0
'Fellippe Heitor, 2017-2026 - @fellippeheitor
'
'Include this file at the end of your program. See README.md for the full API.
'
'Internally, the whole file is kept in memory (IniWholeFile$) and parsed line by line.
'Every line is classified by IniParseLine as one of:
'    0 = blank, 1 = comment, 2 = [section] header, 3 = key=value, 4 = anything else

'================================================================ reading

FUNCTION ReadSetting$ (file$, __section$, __key$)
    SHARED IniCODE, IniLastSection$, IniLastKey$, IniWholeFile$

    DIM sectName$, key$, value$, t$, nm$, raw$, kind%%
    DIM hdr&, body&, sectEnd&, lineStart&, contentEnd&

    IniLoad file$
    IF IniCODE THEN EXIT FUNCTION
    IF LEN(IniTrim$(IniWholeFile$)) = 0 THEN IniCODE = 17: EXIT FUNCTION

    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT FUNCTION

    key$ = IniTrim$(__key$)
    IF key$ = "" THEN
        'sequential reading: next key in the section (or in the whole file)
        ReadSetting$ = IniNextKeyValue$(sectName$)
        EXIT FUNCTION
    END IF
    IF NOT IniValidKey%%(key$) THEN IniCODE = 12: EXIT FUNCTION

    IniLastKey$ = key$
    IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN IniCODE = 14: EXIT FUNCTION
    IniLastSection$ = IniSectionLabel$(hdr&)
    IF NOT IniFindKey%%(body&, sectEnd&, key$, lineStart&, contentEnd&) THEN IniCODE = 3: EXIT FUNCTION

    t$ = MID$(IniWholeFile$, lineStart&, contentEnd& - lineStart&)
    IniParseLine t$, kind%%, nm$, raw$
    IniLastKey$ = nm$

    value$ = IniDecodeValue$(raw$)
    IF value$ = "" THEN IniCODE = 2
    ReadSetting$ = value$
END FUNCTION

FUNCTION IniNextKeyValue$ (sectName$)
    'Returns the next key/value pair of a section ("" = whole file).
    'Iteration state survives changes to the file: after a write, the position
    'is recalculated from the number of keys already returned.
    SHARED IniCODE, IniLastSection$, IniLastKey$, IniWholeFile$, IniCurrentFile$
    SHARED IniDocVersion&, IniIterSig$, IniIterPos&, IniIterCount&, IniIterVersion&, IniIterSect$

    DIM sig$, t$, nm$, raw$, value$, kind%%, allMode%%
    DIM hdr&, body&, sectEnd&, p&, np&, skip&, L&

    allMode%% = (sectName$ = "")
    sig$ = IniCurrentFile$ + CHR$(0) + LCASE$(sectName$)
    IF sig$ <> IniIterSig$ THEN
        IniIterSig$ = sig$
        IniIterCount& = 0
        IniIterVersion& = IniDocVersion& - 1 'force positioning
    END IF

    IF IniIterVersion& <> IniDocVersion& THEN
        IF allMode%% THEN
            IniIterPos& = 1
            IniIterSect$ = "[]"
        ELSE
            IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN
                IniCODE = 14
                IniIterSig$ = ""
                EXIT FUNCTION
            END IF
            IniIterPos& = body&
            IniIterSect$ = IniSectionLabel$(hdr&)
        END IF
        skip& = IniIterCount&
        IniIterVersion& = IniDocVersion&
    END IF

    L& = LEN(IniWholeFile$)
    p& = IniIterPos&
    DO WHILE p& <= L&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 2 THEN
            IF NOT allMode%% THEN EXIT DO
            IniIterSect$ = "[" + nm$ + "]"
        ELSEIF kind%% = 3 THEN
            IF skip& > 0 THEN
                skip& = skip& - 1
            ELSE
                IniIterPos& = np&
                IniIterCount& = IniIterCount& + 1
                IniLastSection$ = IniIterSect$
                IniLastKey$ = nm$
                value$ = IniDecodeValue$(raw$)
                IF value$ = "" THEN IniCODE = 2
                IniNextKeyValue$ = value$
                EXIT FUNCTION
            END IF
        END IF
        p& = np&
    LOOP

    IniCODE = 10
    IniIterSig$ = "" 'the next call starts over
END FUNCTION

FUNCTION IniNextSection$ (file$)
    'Returns the next [section] in the file. After the last one, returns ""
    'with IniCODE = 24, and the next call starts over.
    SHARED IniCODE, IniWholeFile$, IniCurrentFile$, IniDocVersion&
    SHARED IniSectSig$, IniSectPos&, IniSectCount&, IniSectVersion&

    DIM t$, nm$, raw$, kind%%, p&, np&, skip&, L&

    IniLoad file$
    IF IniCODE THEN EXIT FUNCTION

    IF IniCurrentFile$ <> IniSectSig$ THEN
        IniSectSig$ = IniCurrentFile$
        IniSectCount& = 0
        IniSectVersion& = IniDocVersion& - 1
    END IF
    IF IniSectVersion& <> IniDocVersion& THEN
        IniSectPos& = 1
        skip& = IniSectCount&
        IniSectVersion& = IniDocVersion&
    END IF

    L& = LEN(IniWholeFile$)
    p& = IniSectPos&
    DO WHILE p& <= L&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 2 THEN
            IF skip& > 0 THEN
                skip& = skip& - 1
            ELSE
                IniSectPos& = np&
                IniSectCount& = IniSectCount& + 1
                IniNextSection$ = "[" + nm$ + "]"
                EXIT FUNCTION
            END IF
        END IF
        p& = np&
    LOOP

    IniCODE = 24
    IniSectSig$ = ""
END FUNCTION

SUB IniResetIteration
    'Makes the next sequential ReadSetting$ / IniNextSection$ call start from the beginning
    SHARED IniIterSig$, IniSectSig$
    IniIterSig$ = ""
    IniSectSig$ = ""
END SUB

FUNCTION IniGetSection$ (__section$)
    'Returns the raw text of a section (header included) from the current file
    SHARED IniCODE, IniWholeFile$
    DIM sectName$, hdr&, body&, sectEnd&, start&

    IniLoad ""
    IF IniCODE THEN EXIT FUNCTION
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT FUNCTION
    IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN IniCODE = 14: EXIT FUNCTION
    start& = hdr&
    IF start& = 0 THEN start& = 1
    IniGetSection$ = MID$(IniWholeFile$, start&, sectEnd& - start&)
END FUNCTION

FUNCTION IniCurrentSection$
    SHARED IniLastSection$
    IniCurrentSection$ = IniLastSection$
END FUNCTION

'================================================================ writing

SUB WriteSetting (file$, __section$, __key$, __value$)
    SHARED IniCODE, IniLastSection$, IniLastKey$, IniWholeFile$, IniLF$

    DIM sectName$, key$, value$, enc$, doc$, t$, nm$, raw$, prefix$, suffix$, newLine$
    DIM kind%%, hdr&, body&, sectEnd&, lineStart&, contentEnd&, q&, np&

    IniCODE = 0
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT SUB
    key$ = IniTrim$(__key$)
    IF NOT IniValidKey%%(key$) THEN IniCODE = 12: EXIT SUB
    value$ = IniTrim$(__value$)
    IF INSTR(value$, CHR$(10)) > 0 OR INSTR(value$, CHR$(13)) > 0 THEN IniCODE = 25: EXIT SUB
    enc$ = IniEncodeValue$(value$)
    newLine$ = key$ + "=" + enc$

    IniLoad file$
    IF IniCODE = 18 THEN IniCODE = 21: EXIT SUB
    IF IniCODE <> 0 AND IniCODE <> 1 THEN EXIT SUB 'IniCODE = 1 (file not found): it will be created

    IniLastKey$ = key$
    IniLastSection$ = "[" + sectName$ + "]"

    IF LEN(IniTrim$(IniWholeFile$)) = 0 THEN
        'new or empty file
        doc$ = ""
        IF sectName$ <> "" THEN doc$ = "[" + sectName$ + "]" + IniLF$
        IniApply doc$ + newLine$ + IniLF$
        IF IniCODE = 0 THEN IniCODE = 11
        EXIT SUB
    END IF

    IF IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN
        IniLastSection$ = IniSectionLabel$(hdr&)
        IF IniFindKey%%(body&, sectEnd&, key$, lineStart&, contentEnd&) THEN
            'update existing key, keeping its indentation, spelling and inline comment
            t$ = MID$(IniWholeFile$, lineStart&, contentEnd& - lineStart&)
            IniParseLine t$, kind%%, nm$, raw$
            IniLastKey$ = nm$
            IF IniDecodeValue$(raw$) = value$ THEN IniCODE = 8: EXIT SUB
            IniSplitLine t$, prefix$, suffix$
            IniApply LEFT$(IniWholeFile$, lineStart& - 1) + prefix$ + enc$ + suffix$ + MID$(IniWholeFile$, contentEnd&)
            IF IniCODE = 0 THEN IniCODE = 4
        ELSE
            'new key in existing section: add it after the section's last key
            q& = IniLastKeyEnd&(body&, sectEnd&)
            IF q& = 0 THEN
                q& = body&
                IF sectName$ = "" THEN
                    'first global key goes at the top; keep a blank line before the first [section]
                    IniGetLine 1, t$, np&
                    IniParseLine t$, kind%%, nm$, raw$
                    IF kind%% = 2 THEN newLine$ = newLine$ + IniLF$
                END IF
            END IF
            IniApply IniInsertLine$(q&, newLine$)
            IF IniCODE = 0 THEN
                IF sectName$ = "" THEN IniCODE = 5 ELSE IniCODE = 7
            END IF
        END IF
    ELSE
        'new section at the end of the file
        doc$ = IniWholeFile$
        IF RIGHT$(doc$, 1) <> CHR$(10) THEN doc$ = doc$ + IniLF$
        IF NOT IniLastLineBlank%%(doc$) THEN doc$ = doc$ + IniLF$
        IniApply doc$ + "[" + sectName$ + "]" + IniLF$ + newLine$ + IniLF$
        IF IniCODE = 0 THEN IniCODE = 9
    END IF
END SUB

SUB IniDeleteKey (file$, __section$, __key$)
    SHARED IniCODE, IniLastSection$, IniLastKey$, IniWholeFile$

    DIM sectName$, key$, t$, nm$, raw$, kind%%
    DIM hdr&, body&, sectEnd&, lineStart&, contentEnd&, np&

    IniCODE = 0
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT SUB
    key$ = IniTrim$(__key$)
    IF NOT IniValidKey%%(key$) THEN IniCODE = 12: EXIT SUB

    IniLoad file$
    IF IniCODE THEN EXIT SUB
    IF LEN(IniTrim$(IniWholeFile$)) = 0 THEN IniCODE = 17: EXIT SUB

    IniLastKey$ = key$
    IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN IniCODE = 14: EXIT SUB
    IniLastSection$ = IniSectionLabel$(hdr&)
    IF NOT IniFindKey%%(body&, sectEnd&, key$, lineStart&, contentEnd&) THEN IniCODE = 3: EXIT SUB

    IniGetLine lineStart&, t$, np&
    IniParseLine t$, kind%%, nm$, raw$
    IniLastKey$ = nm$
    IniApply LEFT$(IniWholeFile$, lineStart& - 1) + MID$(IniWholeFile$, np&)
    IF IniCODE = 0 THEN IniCODE = 19
END SUB

SUB IniDeleteSection (file$, __section$)
    SHARED IniCODE, IniLastSection$, IniWholeFile$, IniLF$

    DIM sectName$, doc$, t$, nm$, raw$, kind%%, removed&
    DIM hdr&, body&, sectEnd&, p&, np&, lastContent&, delEnd&

    IniCODE = 0
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT SUB

    IniLoad file$
    IF IniCODE THEN EXIT SUB
    IF LEN(IniTrim$(IniWholeFile$)) = 0 THEN IniCODE = 17: EXIT SUB

    IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN IniCODE = 14: EXIT SUB
    IniLastSection$ = IniSectionLabel$(hdr&)

    IF sectName$ = "" THEN
        'global section: remove the keys that come before the first [section]; comments stay
        p& = 1
        DO WHILE p& < sectEnd&
            IniGetLine p&, t$, np&
            IniParseLine t$, kind%%, nm$, raw$
            IF kind%% = 3 THEN removed& = removed& + 1 ELSE doc$ = doc$ + MID$(IniWholeFile$, p&, np& - p&)
            p& = np&
        LOOP
        IF removed& = 0 THEN IniCODE = 14: EXIT SUB
        doc$ = doc$ + MID$(IniWholeFile$, sectEnd&)
    ELSE
        'find where the section's own content ends; comments right before the
        'next [section] header are kept, since they usually describe it
        lastContent& = body&
        p& = body&
        DO WHILE p& < sectEnd&
            IniGetLine p&, t$, np&
            IniParseLine t$, kind%%, nm$, raw$
            IF kind%% = 3 OR kind%% = 4 THEN lastContent& = np&
            p& = np&
        LOOP

        IF sectEnd& <= LEN(IniWholeFile$) THEN
            delEnd& = sectEnd&
            p& = lastContent&
            DO WHILE p& < sectEnd&
                IniGetLine p&, t$, np&
                IniParseLine t$, kind%%, nm$, raw$
                IF kind%% = 1 THEN delEnd& = p&: EXIT DO
                p& = np&
            LOOP
            doc$ = LEFT$(IniWholeFile$, hdr& - 1) + MID$(IniWholeFile$, delEnd&)
        ELSE
            'last section: also drop the blank lines left at the end of the file
            doc$ = LEFT$(IniWholeFile$, hdr& - 1)
            DO WHILE LEN(doc$)
                kind%% = ASC(doc$, LEN(doc$))
                IF kind%% <> 10 AND kind%% <> 13 AND kind%% <> 32 AND kind%% <> 9 THEN EXIT DO
                doc$ = LEFT$(doc$, LEN(doc$) - 1)
            LOOP
            IF LEN(doc$) THEN doc$ = doc$ + IniLF$
        END IF
    END IF

    IniApply doc$
    IF IniCODE = 0 THEN IniCODE = 13
END SUB

SUB IniSortSection (file$, __section$)
    'Sorts the keys of a section alphabetically (case-insensitive).
    'Comments and blank lines keep their places; key lines are kept exactly as written.
    SHARED IniCODE, IniLastSection$, IniWholeFile$

    DIM sectName$, doc$, t$, nm$, raw$, kind%%
    DIM hdr&, body&, sectEnd&, p&, np&, k&, j&, idx&

    IniCODE = 0
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT SUB

    IniLoad file$
    IF IniCODE THEN EXIT SUB
    IF LEN(IniTrim$(IniWholeFile$)) = 0 THEN IniCODE = 17: EXIT SUB

    IF NOT IniFindSection%%(sectName$, hdr&, body&, sectEnd&) THEN IniCODE = 14: EXIT SUB
    IniLastSection$ = IniSectionLabel$(hdr&)

    REDIM keyLine(1 TO 100) AS STRING, sortKey(1 TO 100) AS STRING
    p& = body&
    DO WHILE p& < sectEnd&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 3 THEN
            k& = k& + 1
            IF k& > UBOUND(keyLine) THEN
                REDIM _PRESERVE keyLine(1 TO k& + 100) AS STRING
                REDIM _PRESERVE sortKey(1 TO k& + 100) AS STRING
            END IF
            keyLine(k&) = t$
            sortKey(k&) = LCASE$(nm$) + CHR$(0) + MKL$(k&) 'CHR$(0) makes "a" sort before "a2"
        END IF
        p& = np&
    LOOP

    IF k& < 2 THEN IniCODE = 23: EXIT SUB
    REDIM _PRESERVE sortKey(1 TO k&) AS STRING
    IF IniArraySort%%(sortKey()) = 0 THEN IniCODE = 23: EXIT SUB

    'rebuild the section, putting the sorted key lines in the slots of the old ones
    doc$ = LEFT$(IniWholeFile$, body& - 1)
    p& = body&
    DO WHILE p& < sectEnd&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 3 THEN
            j& = j& + 1
            idx& = CVL(RIGHT$(sortKey(j&), 4))
            doc$ = doc$ + keyLine(idx&) + MID$(IniWholeFile$, p& + LEN(t$), np& - p& - LEN(t$))
        ELSE
            doc$ = doc$ + MID$(IniWholeFile$, p&, np& - p&)
        END IF
        p& = np&
    LOOP
    doc$ = doc$ + MID$(IniWholeFile$, sectEnd&)

    IniApply doc$
    IF IniCODE = 0 THEN IniCODE = 22
END SUB

SUB IniMoveKey (file$, __section$, __key$, __newsection$)
    'A move is a copy + a delete, saved to disk once.
    SHARED IniCODE, IniWholeFile$, IniDisableAutoCommit, IniDirty%%, IniDocVersion&

    DIM src$, dst$, value$, backup$, backupDirty%%, autoCommit

    IniCODE = 0
    IF NOT IniValidSection%%(__section$, src$) THEN IniCODE = 15: EXIT SUB
    IF NOT IniValidSection%%(__newsection$, dst$) THEN IniCODE = 15: EXIT SUB
    IF LCASE$(src$) = LCASE$(dst$) THEN IniCODE = 8: EXIT SUB

    value$ = ReadSetting$(file$, __section$, __key$)
    IF IniCODE <> 0 AND IniCODE <> 2 THEN EXIT SUB

    autoCommit = IniDisableAutoCommit
    IniDisableAutoCommit = -1
    backup$ = IniWholeFile$
    backupDirty%% = IniDirty%%

    WriteSetting "", __newsection$, __key$, value$
    IF NOT IniIsError%% THEN IniDeleteKey "", __section$, __key$

    IniDisableAutoCommit = autoCommit
    IF NOT IniIsError%% AND autoCommit = 0 THEN IniCommit

    IF IniIsError%% THEN
        IniWholeFile$ = backup$
        IniDirty%% = backupDirty%%
        IniDocVersion& = IniDocVersion& + 1
        EXIT SUB
    END IF
    IniCODE = 20
END SUB

'================================================================ files

SUB IniLoad (file$)
    'Makes file$ the current file, reading it from disk when needed.
    'Passing "" keeps using the current file.
    SHARED IniCODE, IniCurrentFile$, IniWholeFile$, IniLF$, IniForceReload
    SHARED IniLoaded%%, IniDirty%%, IniDocVersion&

    DIM f$, dat$

    IniCODE = 0
    f$ = file$ 'never change the caller's variable
    IF f$ = "" THEN f$ = IniCurrentFile$
    IF f$ = "" THEN IniCODE = 18: EXIT SUB

    IF f$ <> IniCurrentFile$ THEN
        'switching files: save pending changes (IniDisableAutoCommit) of the previous one first
        IF IniDirty%% THEN
            IniCommit
            IF IniCODE THEN EXIT SUB
        END IF
        IniCurrentFile$ = f$
        IniLoaded%% = 0
    ELSE
        IF IniDirty%% THEN EXIT SUB 'uncommitted changes in memory are the most recent version
        IF IniLoaded%% AND IniForceReload = 0 THEN
            IF _FILEEXISTS(f$) THEN EXIT SUB
        END IF
    END IF

    IniLoaded%% = 0
    IF NOT _FILEEXISTS(f$) THEN
        IniCODE = 1
        IF LEN(IniWholeFile$) THEN IniWholeFile$ = "": IniDocVersion& = IniDocVersion& + 1
        $IF WIN THEN
            IniLF$ = CHR$(13) + CHR$(10)
        $ELSE
            IniLF$ = CHR$(10)
        $END IF
        EXIT SUB
    END IF

    IF NOT IniReadFile%%(f$, dat$) THEN IniCODE = 27: EXIT SUB
    IniLoaded%% = -1
    IF dat$ <> IniWholeFile$ THEN IniWholeFile$ = dat$: IniDocVersion& = IniDocVersion& + 1

    'keep the file's own line endings
    IF INSTR(dat$, CHR$(13) + CHR$(10)) THEN
        IniLF$ = CHR$(13) + CHR$(10)
    ELSEIF INSTR(dat$, CHR$(10)) THEN
        IniLF$ = CHR$(10)
    ELSE
        $IF WIN THEN
            IniLF$ = CHR$(13) + CHR$(10)
        $ELSE
            IniLF$ = CHR$(10)
        $END IF
    END IF
END SUB

SUB IniCommit
    'Writes pending changes to disk. Only needed when IniDisableAutoCommit is set.
    SHARED IniCODE, IniCurrentFile$, IniWholeFile$, IniDirty%%, IniLoaded%%

    IF IniCurrentFile$ = "" THEN IniCODE = 18: EXIT SUB
    IniCODE = 0
    IF NOT IniDirty%% THEN EXIT SUB
    IF NOT IniWriteFile%%(IniCurrentFile$, IniWholeFile$) THEN IniCODE = 26: EXIT SUB
    IniDirty%% = 0
    IniLoaded%% = -1
END SUB

SUB IniClose
    'Saves pending changes (if any) and forgets the current file.
    SHARED IniCODE, IniCurrentFile$, IniWholeFile$, IniDirty%%, IniLoaded%%, IniDocVersion&

    IniCODE = 0
    IF IniCurrentFile$ = "" THEN EXIT SUB
    IF IniDirty%% THEN
        IniCommit
        IF IniCODE THEN EXIT SUB
    END IF
    IniCurrentFile$ = ""
    IniWholeFile$ = ""
    IniLoaded%% = 0
    IniDocVersion& = IniDocVersion& + 1
    IniResetIteration
END SUB

SUB IniSetAddQuotes (state AS _BYTE)
    'When disabled, values only get quotation marks if they could not be read back without them
    SHARED IniDisableAddQuotes
    IF state THEN IniDisableAddQuotes = 0 ELSE IniDisableAddQuotes = -1
END SUB

SUB IniSetAllowBasicComments (state AS _BYTE)
    SHARED IniAllowBasicComments
    IF state THEN IniAllowBasicComments = -1 ELSE IniAllowBasicComments = 0
END SUB

SUB IniSetAutoCommit (state AS _BYTE)
    SHARED IniDisableAutoCommit
    IF state THEN IniDisableAutoCommit = 0 ELSE IniDisableAutoCommit = -1
END SUB

SUB IniSetForceReload (state AS _BYTE)
    SHARED IniForceReload
    IF state THEN IniForceReload = -1 ELSE IniForceReload = 0
END SUB

SUB IniApply (newDoc$)
    'Replaces the in-memory file and saves it, unless IniDisableAutoCommit is set.
    'If saving fails, the in-memory file is restored, so memory and disk stay in sync.
    SHARED IniCODE, IniWholeFile$, IniDisableAutoCommit, IniDirty%%, IniDocVersion&

    DIM old$, oldDirty%%

    old$ = IniWholeFile$
    oldDirty%% = IniDirty%%
    IniWholeFile$ = newDoc$
    IniDirty%% = -1
    IniDocVersion& = IniDocVersion& + 1
    IniCODE = 0

    IF IniDisableAutoCommit = 0 THEN
        IniCommit
        IF IniCODE THEN
            IniWholeFile$ = old$
            IniDirty%% = oldDirty%%
            IniDocVersion& = IniDocVersion& + 1
        END IF
    END IF
END SUB

FUNCTION IniReadFile%% (f$, dat$)
    SHARED IniIOError&
    DIM n&

    $IF INI_SAFEIO = 1 THEN
        ON ERROR GOTO _NEWHANDLER IniIOErrorHandler
    $END IF
    IniIOError& = 0

    dat$ = ""
    n& = FREEFILE
    OPEN f$ FOR BINARY ACCESS READ AS #n&
    IF IniIOError& = 0 THEN
        dat$ = SPACE$(LOF(n&))
        IF LEN(dat$) THEN GET #n&, 1, dat$
        CLOSE #n&
    END IF

    $IF INI_SAFEIO = 1 THEN
        ON ERROR GOTO _LASTHANDLER
    $END IF
    IniReadFile%% = (IniIOError& = 0)
END FUNCTION

FUNCTION IniWriteFile%% (f$, dat$)
    'Writes to a temporary file first, then replaces the original with it,
    'so a failed write never leaves a half-written .ini behind.
    SHARED IniIOError&
    DIM n&, tmp$, killed%%

    tmp$ = f$ + ".inimgr.tmp"

    $IF INI_SAFEIO = 1 THEN
        ON ERROR GOTO _NEWHANDLER IniIOErrorHandler
    $END IF
    IniIOError& = 0

    IF _FILEEXISTS(f$) THEN
        'refuse to replace read-only or locked files
        n& = FREEFILE
        OPEN f$ FOR APPEND AS #n&
        IF IniIOError& = 0 THEN CLOSE #n&
    END IF

    IF IniIOError& = 0 THEN
        n& = FREEFILE
        OPEN tmp$ FOR OUTPUT AS #n&
        IF IniIOError& = 0 THEN
            CLOSE #n&
            OPEN tmp$ FOR BINARY AS #n&
            IF IniIOError& = 0 THEN
                IF LEN(dat$) THEN PUT #n&, 1, dat$
                CLOSE #n&
            END IF
        END IF
    END IF

    IF IniIOError& = 0 THEN
        IF _FILEEXISTS(f$) THEN KILL f$: killed%% = -1
    END IF
    IF IniIOError& = 0 THEN NAME tmp$ AS f$

    IF IniIOError& <> 0 AND NOT killed%% THEN
        'the original file is untouched; remove the temporary copy
        IF _FILEEXISTS(tmp$) THEN KILL tmp$
    END IF

    $IF INI_SAFEIO = 1 THEN
        ON ERROR GOTO _LASTHANDLER
    $END IF
    IniWriteFile%% = (IniIOError& = 0)
END FUNCTION

'================================================================ parsing helpers

SUB IniGetLine (p&, text$, nextP&)
    'Returns the line starting at p& (without CR/LF) and where the next line starts
    SHARED IniWholeFile$
    DIM e&

    e& = INSTR(p&, IniWholeFile$, CHR$(10))
    IF e& = 0 THEN e& = LEN(IniWholeFile$) + 1
    nextP& = e& + 1
    IF e& > p& THEN
        IF ASC(IniWholeFile$, e& - 1) = 13 THEN e& = e& - 1
    END IF
    text$ = MID$(IniWholeFile$, p&, e& - p&)
END SUB

SUB IniParseLine (text$, kind%%, nm$, raw$)
    DIM t$, c$, i&

    nm$ = ""
    raw$ = ""
    t$ = IniTrim$(text$)
    IF t$ = "" THEN kind%% = 0: EXIT SUB

    c$ = LEFT$(t$, 1)
    IF c$ = ";" OR c$ = "#" OR c$ = "'" THEN kind%% = 1: EXIT SUB

    IF c$ = "[" THEN
        i& = INSTR(t$, "]")
        IF i& THEN
            kind%% = 2
            nm$ = IniTrim$(MID$(t$, 2, i& - 2))
        ELSE
            kind%% = 4
        END IF
        EXIT SUB
    END IF

    i& = INSTR(t$, "=")
    IF i& > 1 THEN
        nm$ = IniTrim$(LEFT$(t$, i& - 1))
        raw$ = MID$(t$, i& + 1)
        kind%% = 3
        EXIT SUB
    END IF

    kind%% = 4
END SUB

FUNCTION IniFindSection%% (sectName$, hdr&, body&, sectEnd&)
    'Locates a section ("" = global keys before the first [section]).
    'hdr& = header line (0 for global), body& = first line after it,
    'sectEnd& = start of the next [section] header (or end of file + 1).
    SHARED IniWholeFile$
    DIM t$, nm$, raw$, target$, kind%%, found%%, p&, np&, L&

    L& = LEN(IniWholeFile$)
    hdr& = 0
    body& = 0
    sectEnd& = L& + 1
    target$ = LCASE$(sectName$)
    IF sectName$ = "" THEN found%% = -1: body& = 1

    p& = 1
    DO WHILE p& <= L&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 2 THEN
            IF found%% THEN sectEnd& = p&: EXIT DO
            IF LCASE$(nm$) = target$ THEN found%% = -1: hdr& = p&: body& = np&
        END IF
        p& = np&
    LOOP

    IniFindSection%% = found%%
END FUNCTION

FUNCTION IniFindKey%% (body&, sectEnd&, key$, lineStart&, contentEnd&)
    SHARED IniWholeFile$
    DIM t$, nm$, raw$, target$, kind%%, p&, np&

    target$ = LCASE$(key$)
    p& = body&
    DO WHILE p& < sectEnd&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 2 THEN EXIT DO
        IF kind%% = 3 THEN
            IF LCASE$(nm$) = target$ THEN
                lineStart& = p&
                contentEnd& = p& + LEN(t$)
                IniFindKey%% = -1
                EXIT FUNCTION
            END IF
        END IF
        p& = np&
    LOOP
END FUNCTION

FUNCTION IniLastKeyEnd& (body&, sectEnd&)
    'Start of the line after the last key in the range (0 if there are no keys)
    DIM t$, nm$, raw$, kind%%, p&, np&

    p& = body&
    DO WHILE p& < sectEnd&
        IniGetLine p&, t$, np&
        IniParseLine t$, kind%%, nm$, raw$
        IF kind%% = 2 THEN EXIT DO
        IF kind%% = 3 THEN IniLastKeyEnd& = np&
        p& = np&
    LOOP
END FUNCTION

FUNCTION IniSectionLabel$ (hdr&)
    DIM t$, nm$, raw$, kind%%, np&
    IF hdr& = 0 THEN IniSectionLabel$ = "[]": EXIT FUNCTION
    IniGetLine hdr&, t$, np&
    IniParseLine t$, kind%%, nm$, raw$
    IniSectionLabel$ = "[" + nm$ + "]"
END FUNCTION

FUNCTION IniInsertLine$ (position&, text$)
    SHARED IniWholeFile$, IniLF$
    DIM q&, pre$

    q& = position&
    IF q& > LEN(IniWholeFile$) + 1 THEN q& = LEN(IniWholeFile$) + 1
    pre$ = LEFT$(IniWholeFile$, q& - 1)
    IF LEN(pre$) > 0 AND RIGHT$(pre$, 1) <> CHR$(10) THEN pre$ = pre$ + IniLF$
    IniInsertLine$ = pre$ + text$ + IniLF$ + MID$(IniWholeFile$, q&)
END FUNCTION

FUNCTION IniLastLineBlank%% (doc$)
    'doc$ must end with a line feed
    DIM t$, i&
    t$ = LEFT$(doc$, LEN(doc$) - 1)
    i& = _INSTRREV(t$, CHR$(10))
    IniLastLineBlank%% = (LEN(IniTrim$(MID$(t$, i& + 1))) = 0)
END FUNCTION

FUNCTION IniCommentPos& (v$)
    'Position of an inline comment in an unquoted value (0 if none)
    SHARED IniAllowBasicComments
    DIM c&, b&
    c& = INSTR(v$, ";")
    IF IniAllowBasicComments THEN
        b& = INSTR(v$, "'")
        IF b& > 0 AND (c& = 0 OR b& < c&) THEN c& = b&
    END IF
    IniCommentPos& = c&
END FUNCTION

FUNCTION IniDecodeValue$ (raw$)
    'Unquoted values end at an inline comment.
    'Quoted values are taken literally, with "" standing for one quotation mark.
    DIM v$, out$, i&, c%

    v$ = IniTrim$(raw$)
    IF LEFT$(v$, 1) = CHR$(34) THEN
        i& = 2
        DO WHILE i& <= LEN(v$)
            c% = ASC(v$, i&)
            IF c% = 34 THEN
                IF i& = LEN(v$) THEN EXIT DO
                IF ASC(v$, i& + 1) <> 34 THEN EXIT DO
                i& = i& + 1 'doubled quote
            END IF
            out$ = out$ + CHR$(c%)
            i& = i& + 1
        LOOP
        IniDecodeValue$ = out$
    ELSE
        i& = IniCommentPos&(v$)
        IF i& THEN v$ = IniTrim$(LEFT$(v$, i& - 1))
        IniDecodeValue$ = v$
    END IF
END FUNCTION

FUNCTION IniEncodeValue$ (v$)
    'Adds quotation marks when the value would not read back as written
    SHARED IniDisableAddQuotes
    DIM needQuotes%%, i&, out$

    needQuotes%% = INSTR(v$, ";") > 0 OR INSTR(v$, "'") > 0
    IF IniDisableAddQuotes = 0 THEN
        IF INSTR(v$, " ") > 0 OR INSTR(v$, CHR$(9)) > 0 THEN needQuotes%% = -1
    END IF
    IF LEFT$(v$, 1) = CHR$(34) THEN needQuotes%% = -1

    IF NOT needQuotes%% THEN IniEncodeValue$ = v$: EXIT FUNCTION

    FOR i& = 1 TO LEN(v$)
        IF ASC(v$, i&) = 34 THEN out$ = out$ + CHR$(34) + CHR$(34) ELSE out$ = out$ + MID$(v$, i&, 1)
    NEXT
    IniEncodeValue$ = CHR$(34) + out$ + CHR$(34)
END FUNCTION

SUB IniSplitLine (text$, prefix$, suffix$)
    'Splits a key=value line into what comes before the value
    '(key, "=" and spacing) and what comes after it (inline comment).
    DIM eq&, i&, j&, rest$, v$

    eq& = INSTR(text$, "=")
    rest$ = MID$(text$, eq& + 1)
    i& = 1
    DO WHILE i& <= LEN(rest$)
        IF ASC(rest$, i&) <> 32 AND ASC(rest$, i&) <> 9 THEN EXIT DO
        i& = i& + 1
    LOOP
    prefix$ = LEFT$(text$, eq&) + LEFT$(rest$, i& - 1)
    v$ = MID$(rest$, i&)
    suffix$ = ""

    IF LEFT$(v$, 1) = CHR$(34) THEN
        j& = 2
        DO WHILE j& <= LEN(v$)
            IF ASC(v$, j&) = 34 THEN
                IF j& = LEN(v$) THEN EXIT DO
                IF ASC(v$, j& + 1) <> 34 THEN EXIT DO
                j& = j& + 1
            END IF
            j& = j& + 1
        LOOP
        suffix$ = MID$(v$, j& + 1)
    ELSE
        j& = IniCommentPos&(v$)
        IF j& > 0 THEN
            j& = j& - 1
            DO WHILE j& >= 1
                IF ASC(v$, j&) <> 32 AND ASC(v$, j&) <> 9 THEN EXIT DO
                j& = j& - 1
            LOOP
            suffix$ = MID$(v$, j& + 1)
        END IF
    END IF
END SUB

FUNCTION IniTrim$ (s$)
    'Removes spaces, tabs, CR and LF from both ends
    DIM a&, b&, c%

    a& = 1
    b& = LEN(s$)
    DO WHILE a& <= b&
        c% = ASC(s$, a&)
        IF c% <> 32 AND c% <> 9 AND c% <> 13 AND c% <> 10 THEN EXIT DO
        a& = a& + 1
    LOOP
    DO WHILE b& >= a&
        c% = ASC(s$, b&)
        IF c% <> 32 AND c% <> 9 AND c% <> 13 AND c% <> 10 THEN EXIT DO
        b& = b& - 1
    LOOP
    IniTrim$ = MID$(s$, a&, b& - a& + 1)
END FUNCTION

FUNCTION IniValidSection%% (s$, sectName$)
    'Accepts "name" or "[name]"; returns the bare name in sectName$ ("" = global)
    DIM t$

    t$ = IniTrim$(s$)
    IF LEFT$(t$, 1) = "[" THEN t$ = MID$(t$, 2)
    IF RIGHT$(t$, 1) = "]" THEN t$ = LEFT$(t$, LEN(t$) - 1)
    t$ = IniTrim$(t$)
    sectName$ = t$
    IF INSTR(t$, "[") OR INSTR(t$, "]") OR INSTR(t$, CHR$(10)) OR INSTR(t$, CHR$(13)) THEN EXIT FUNCTION
    IniValidSection%% = -1
END FUNCTION

FUNCTION IniFormatSection$ (__section$)
    SHARED IniCODE
    DIM sectName$
    IF NOT IniValidSection%%(__section$, sectName$) THEN IniCODE = 15: EXIT FUNCTION
    IniFormatSection$ = "[" + sectName$ + "]"
END FUNCTION

FUNCTION IniValidKey%% (key$)
    'key$ must already be trimmed
    DIM c$
    IF key$ = "" THEN EXIT FUNCTION
    c$ = LEFT$(key$, 1)
    IF c$ = ";" OR c$ = "#" OR c$ = "'" OR c$ = "[" THEN EXIT FUNCTION
    IF INSTR(key$, "=") OR INSTR(key$, CHR$(10)) OR INSTR(key$, CHR$(13)) THEN EXIT FUNCTION
    IniValidKey%% = -1
END FUNCTION

'================================================================ status

FUNCTION IniIsError%%
    'True (-1) if the last operation failed
    IniIsError%% = (LEFT$(IniINFO$, 6) = "ERROR:")
END FUNCTION

FUNCTION IniINFO$
    SHARED IniCODE
    SELECT CASE IniCODE
        CASE 0: IniINFO$ = "Operation successful"
        CASE 1: IniINFO$ = "ERROR: File not found"
        CASE 2: IniINFO$ = "Empty value"
        CASE 3: IniINFO$ = "ERROR: Key not found"
        CASE 4: IniINFO$ = "Key updated"
        CASE 5: IniINFO$ = "Global key created"
        CASE 7: IniINFO$ = "Key created in existing section"
        CASE 8: IniINFO$ = "No changes applied"
        CASE 9: IniINFO$ = "New section created; key created"
        CASE 10: IniINFO$ = "No more keys"
        CASE 11: IniINFO$ = "File created; new key added"
        CASE 12: IniINFO$ = "ERROR: Invalid key"
        CASE 13: IniINFO$ = "Section deleted"
        CASE 14: IniINFO$ = "ERROR: Section not found"
        CASE 15: IniINFO$ = "ERROR: Invalid section"
        CASE 17: IniINFO$ = "ERROR: Empty file"
        CASE 18: IniINFO$ = "ERROR: No file open"
        CASE 19: IniINFO$ = "Key deleted"
        CASE 20: IniINFO$ = "Key moved"
        CASE 21: IniINFO$ = "ERROR: Invalid file name/path"
        CASE 22: IniINFO$ = "Section sorted"
        CASE 23: IniINFO$ = "No changes applied; section already sorted"
        CASE 24: IniINFO$ = "No more sections"
        CASE 25: IniINFO$ = "ERROR: Invalid value (line breaks are not allowed)"
        CASE 26: IniINFO$ = "ERROR: Could not write file"
        CASE 27: IniINFO$ = "ERROR: Could not read file"
        CASE ELSE: IniINFO$ = "ERROR: <invalid error code>"
    END SELECT
END FUNCTION

'Written in BASIC by Luke Ceddia for ide_methods.bas (QB64)
'After Cormen, Leiserson, Rivest & Stein "Introduction To Algorithms" via Wikipedia
'Adapted for use in INI Manager
FUNCTION IniArraySort%% (arr() AS STRING)
    DIM i&, x$, j&, moves&

    FOR i& = LBOUND(arr) + 1 TO UBOUND(arr)
        x$ = arr(i&)
        j& = i& - 1
        WHILE j& >= LBOUND(arr)
            IF arr(j&) <= x$ THEN EXIT WHILE
            moves& = moves& + 1
            arr(j& + 1) = arr(j&)
            j& = j& - 1
        WEND
        arr(j& + 1) = x$
    NEXT i&

    'Returns -1 (true) if any changes were made
    IniArraySort%% = moves& > 0
END FUNCTION
