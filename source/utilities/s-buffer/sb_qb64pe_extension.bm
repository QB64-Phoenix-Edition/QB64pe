'--- This function simulates the open behavior of real files depending
'--- on the file OPEN mode. That way the file OPEN calls are easily
'--- replaceable by OpenBuffer%() calls without worry about the internal
'--- differences of the buffer system compared to real files.
'--- Respective CLOSE calls can be simply removed as buffers remain
'--- always accessible until cleared/disposed.
'-----
'--- The file names given to this function should be just the same as
'--- you would use to open a real file, i.e. inclusive full or relative
'--- path as required.
'--- Modes names can be short, only the first character is checked.
'---------------------------------------------------------------------
FUNCTION OpenBuffer% (sbMode$, sbName$)
    '--- option _explicit requirements ---
    DIM buf%, nul&
    '--- buffer already existing? ---
    FOR buf% = 0 TO UBOUND(SBufN)
        IF SBufN(buf%) = sbName$ THEN EXIT FOR
    NEXT buf%
    '--- simulate file modes ---
    SELECT CASE UCASE$(LEFT$(sbMode$, 1))
        CASE "A" 'append
            IF buf% > UBOUND(SBufN) THEN GOSUB newBuf
            nul& = SeekBuf&(buf%, 0, SBM_BufEnd)
        CASE "B" 'binary
            IF buf% > UBOUND(SBufN) THEN GOSUB newBuf
            nul& = SeekBuf&(buf%, 0, SBM_BufStart)
        CASE "I" 'input (try to load from file, if yet unknown)
            IF buf% > UBOUND(SBufN) THEN GOSUB loadBuf
            nul& = SeekBuf&(buf%, 0, SBM_BufStart)
        CASE "O" 'output
            IF buf% <= UBOUND(SBufN) THEN DisposeBuf buf%: SBufN(buf%) = ""
            GOSUB newBuf
        CASE ELSE 'random or unknown mode
            buf% = SBE_NoMoreBuffers 'not supported
    END SELECT
    OpenBuffer% = buf%
    EXIT FUNCTION
    '----------
    newBuf:
    buf% = CreateBuf%: ConvBufToNativeEol buf%
    IF buf% > UBOUND(SBufN) THEN
        REDIM _PRESERVE SBufN(0 TO buf% + 99) AS STRING 'extend by 100 buffers
        REDIM _PRESERVE SBufCppLineStatus(0 TO buf% + 99) AS _Byte 'extend by 100 buffers
    END IF
    SBufN(buf%) = sbName$
    RETURN
    '----------
    loadBuf:
    buf% = FileToBuf%(sbName$): ConvBufToNativeEol buf%
    IF buf% > UBOUND(SBufN) THEN
        REDIM _PRESERVE SBufN(0 TO buf% + 99) AS STRING 'extend by 100 buffers
        REDIM _PRESERVE SBufCppLineStatus(0 TO buf% + 99) AS _Byte 'extend by 100 buffers
    END IF
    SBufN(buf%) = sbName$
    RETURN
END FUNCTION

'--- This subroutine will clear the given buffer or ALL buffers, if the
'--- name argument is empty.
'--- Clearing a buffer is the equivalent to KILLing a real file.
'-----
'--- To designate a single buffer to clear, use the same file name as
'--- given at the respective OpenBuffer%() call.
'---------------------------------------------------------------------
SUB ClearBuffers (sbName$)
    '--- option _explicit requirements ---
    DIM buf%
    '--- clear/dispose buffer(s) ---
    IF sbName$ <> "" THEN
        FOR buf% = 0 TO UBOUND(SBufN)
            IF SBufN(buf%) = sbName$ THEN EXIT FOR 'buffer found
        NEXT buf%
        IF buf% > UBOUND(SBufN) THEN EXIT SUB 'buffer doesn't exist
        DisposeBuf buf%: SBufN(buf%) = ""
        SBufCppLineStatus(buf%) = 0
    ELSE
        FOR buf% = 0 TO UBOUND(SBufN)
            IF SBufN(buf%) <> "" THEN DisposeBuf buf%: SBufN(buf%) = ""
            SBufCppLineStatus(buf%) = 0
        NEXT buf%
    END IF
END SUB

'--- This subroutine will write the current contents of the given buffer
'--- or ALL buffers, if the name argument is empty, into the respective
'--- files on disk (using names as given by the OpenBuffer%() function)
'--- The change state of the buffer(s) is checked first to avoid needless
'--- disk writes.
'-----
'--- To designate a single buffer to write, use the same file name as
'--- given at the respective OpenBuffer%() call.
'---------------------------------------------------------------------
SUB WriteBuffers (sbName$)
    '--- option _explicit requirements ---
    DIM buf%
    '--- write buffer(s) ---
    IF sbName$ <> "" THEN
        FOR buf% = 0 TO UBOUND(SBufN)
            IF SBufN(buf%) = sbName$ THEN EXIT FOR 'buffer found
        NEXT buf%
        IF buf% > UBOUND(SBufN) THEN EXIT SUB 'buffer doesn't exist
        IF IsBufChanged%(buf%) THEN BufToFile buf%, SBufN(buf%)
    ELSE
        FOR buf% = 0 TO UBOUND(SBufN)
            IF SBufN(buf%) <> "" THEN
                IF IsBufChanged%(buf%) THEN BufToFile buf%, SBufN(buf%)
            END IF
        NEXT buf%
    END IF
END SUB

' This is the directory that the user's main source file lives, and thus the
' path where all other debug paths are made relative too (so when the debugger
' is run from that location, paths can be resolved).
FUNCTION DebugPathBase$
    IF LEN(path.source$) THEN
        DebugPathBase$ = path.source$
    ELSE
        'path.source$ is empty when the source was given without a directory
        DebugPathBase$ = getfilepath$(_FULLPATH$(sourcefile$))
    END IF
END FUNCTION

' Resolves the path used for a source file in embedded debug info (#line entries).
'
' When AbsoluteDebugPaths is set, all paths are resolved to be absolute paths
' to that file on this machine. This is the simplest form to ensure the path
' will always be resolved correctly by a debugger, but it is not portable (the
' absolute paths won't be correct on another machine).
'
' When not set, we resolve all file paths for the user's program relative to
' the main source location.  Internal files remain relative to the QB64-PE
' source (and we can detect them via the 'internal' or 'libraries' location
' they will have). A debugger can then be given those locations to look at for
' resolving the source files.
FUNCTION ResolveDebugPath$ (path$, isInternal As Long)
    DIM fixedPath AS STRING

    'The auto-included support files are named with "\" separators no matter the
    'platform, and $INCLUDE paths come straight from the user, so neither is
    'guaranteed to use the separator a debugger (or MakeRelativePath$) expects
    fixedPath = path$
    PATH_SLASH_CORRECT fixedPath

    IF AbsoluteDebugPaths THEN
        ResolveDebugPath$ = _FULLPATH$(fixedPath)
    ELSEIF isInternal THEN
        ResolveDebugPath$ = fixedPath
    ELSE
        ResolveDebugPath$ = MakeRelativePath$(DebugPathBase$, _FULLPATH$(fixedPath))
    END IF
END FUNCTION

SUB AddCppLine (buf As LONG)
    DIM incName AS STRING
    DIM lineNum AS LONG
    DIM isInternal AS LONG

    IF inclinenumber(inclevel) THEN
        lineNum = inclinenumber(inclevel)
        incName = incname$(inclevel)
        isInternal = incIsInternal(inclevel)
    ELSE
        lineNum = linenumber
        incName = sourcefile$
        isInternal = _FALSE
    END IF

    incName = ResolveDebugPath$(incName, isInternal)

    'line 0 is out of range for the C preprocessor, which we can end up with
    'before the first line of the program has been read
    IF lineNum < 1 THEN lineNum = 1

    WriteBufLine buf, "#line " + _TOSTR$(lineNum) + " " + CHR$(34) + GetEscapedPath$(incName) + CHR$(34)
END SUB

SUB WriteBufLineCpp (buf As Long, s as String)
    IF NOT SBufCppLineStatus(buf) THEN
        AddCppLine buf
    ELSE
        SBufCppLineStatus(buf) = _FALSE
    END IF
    WriteBufLine buf, s
END SUB

SUB WriteBufRawDataCpp (buf AS LONG, s AS STRING)
    IF NOT SBufCppLineStatus(buf) THEN
        AddCppLine buf
        SBufCppLineStatus(buf) = _TRUE
    END IF
    WriteBufRawData buf, s
END SUB
