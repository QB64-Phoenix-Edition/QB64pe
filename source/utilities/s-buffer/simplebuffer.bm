'--- docs\SeekBuf.html
'---------------------------------------------------------------------
FUNCTION SeekBuf& (handle%, displace&, mode%)
    '--- option _explicit requirements ---
    DIM buf&, cur&, eob&, brc$, brl%, origin&, newPos&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- prepare values ---
    cur& = GetBufPos&(handle%): eob& = GetBufLen&(handle%) + 1
    brc$ = BufEolSeq$(handle%): brl% = LEN(brc$)
    '--- select origin ---
    SELECT CASE mode%
        CASE SBM_PosRestore: origin& = 0
        CASE SBM_BufStart: origin& = 1
        CASE SBM_BufCurrent: origin& = cur&
        CASE SBM_BufEnd: origin& = eob&
        CASE SBM_LineStart
            origin& = cur&
            IF cur& > 1 AND cur& < eob& THEN
                IF brl% = 2 AND ASC(simplebuffer_array$(buf& + 0), cur& - 1) = 13 AND ASC(simplebuffer_array$(buf& + 0), cur&) = 10 THEN
                    origin& = cur& - 1
                END IF
            END IF
            WHILE origin& > 1
                IF MID$(simplebuffer_array$(buf& + 0), origin& - 1, brl%) = brc$ THEN
                    IF brl% = 2 THEN origin& = origin& + 1
                    EXIT WHILE
                END IF
                origin& = origin& - 1
            WEND
        CASE SBM_LineEnd
            origin& = cur&
            IF cur& > 1 AND cur& < eob& THEN
                IF brl% = 2 AND ASC(simplebuffer_array$(buf& + 0), cur& - 1) = 13 AND ASC(simplebuffer_array$(buf& + 0), cur&) = 10 THEN
                    origin& = cur& - 1
                END IF
            END IF
            origin& = INSTR(origin&, simplebuffer_array$(buf& + 0), brc$)
            IF origin& = 0 THEN origin& = eob&
        CASE ELSE
            SeekBuf& = SBE_UnknownMode
            EXIT FUNCTION
    END SELECT
    '--- seek to new position ---
    newPos& = origin& + displace&
    IF newPos& < 1 OR newPos& > eob& THEN
        SeekBuf& = SBE_OutOfBounds
    ELSE
        MID$(simplebuffer_array$(buf& + 1), 1, 4) = MKL$(newPos&)
        SeekBuf& = cur& 'return old position
    END IF
END FUNCTION

'--- docs\GetBufPos.html
'---------------------------------------------------------------------
FUNCTION GetBufPos& (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- return cursor position in buffer ---
    GetBufPos& = CVL(MID$(simplebuffer_array$(buf& + 1), 1, 4))
END FUNCTION

'--- docs\GetBufLen.html
'---------------------------------------------------------------------
FUNCTION GetBufLen& (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- return actual buffer length ---
    GetBufLen& = CVL(MID$(simplebuffer_array$(buf& + 1), 5, 4))
END FUNCTION

'--- docs\EndOfBuf.html
'---------------------------------------------------------------------
FUNCTION EndOfBuf% (handle%)
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    '--- return EndOfBuffer condition ---
    EndOfBuf% = (GetBufPos&(handle%) > GetBufLen&(handle%))
END FUNCTION

'--- docs\IsBufChanged.html
'---------------------------------------------------------------------
FUNCTION IsBufChanged% (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- return BufChanged condition ---
    IsBufChanged% = CVL(MID$(simplebuffer_array$(buf& + 1), 13, 4))
END FUNCTION

'--- docs\BufEolSeq.html
'---------------------------------------------------------------------
FUNCTION BufEolSeq$ (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- return buffer specific EndOfLine sequence ---
    SELECT CASE MID$(simplebuffer_array$(buf& + 1), 9, 4)
        CASE "EolU", "EolN" 'unknown (maybe mixed) or OS-native EOL mode
            BufEolSeq$ = simplebuffer_nativeEol$
        CASE "EolL" 'forced Linux/MacOSX
            BufEolSeq$ = simplebuffer_lnxEol$
        CASE "EolW" 'forced Windows
            BufEolSeq$ = simplebuffer_winEol$
    END SELECT
END FUNCTION

'--- docs\ConvBufToAnyEol.html
'---------------------------------------------------------------------
SUB ConvBufToNativeEol (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- convert buffer to OS native EndOfLine sequence ---
    IF INSTR(_OS$, "[LINUX]") > 0 THEN 'true for MacOSX too
        ConvBufToLnxMacEol handle%
    ELSE
        ConvBufToWinEol handle%
    END IF
    MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolN"
END SUB

'--- docs\ConvBufToAnyEol.html
'---------------------------------------------------------------------
SUB ConvBufToLnxMacEol (handle%)
    '--- option _explicit requirements ---
    DIM buf&, cbl&, cur&, srcPos&, dstPos&, span&, po&, removed&, newLen&, ext&, fsz&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- check current EndOfLine sequence ---
    IF MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolL" THEN EXIT SUB
    IF MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolN" AND LEN(BufEolSeq$(handle%)) = 1 THEN EXIT SUB
    '--- prepare values ---
    cbl& = GetBufLen&(handle%): cur& = GetBufPos&(handle%)

    ' If the cursor is already on a CRLF, point it at the LF (since that's what will be left over)
    IF MID$(simplebuffer_array$(buf& + 0), cur&, 2) = simplebuffer_winEol$ THEN cur& = cur& + 1

    ' Search for every CRLF and drop the CR. We keep track of the number of
    ' characters removed before the cursor to adjust it at the end.
    srcPos& = 1: dstPos& = 1
    DO
        po& = INSTR(srcPos&, simplebuffer_array$(buf& + 0), simplebuffer_winEol$)
        IF po& = 0 OR po& >= cbl& THEN EXIT DO

        IF po& < cur& THEN removed& = removed& + 1
        span& = po& - srcPos&
        IF span& > 0 AND dstPos& < srcPos& THEN
            MID$(simplebuffer_array$(buf& + 0), dstPos&, span&) = MID$(simplebuffer_array$(buf& + 0), srcPos&, span&)
        END IF

        dstPos& = dstPos& + span&: srcPos& = po& + 1
    LOOP

    ' Move the remainder of the string and also resize it if it makes sense to do so
    IF dstPos& < srcPos& THEN
        span& = cbl& - srcPos& + 1
        IF span& > 0 THEN
            MID$(simplebuffer_array$(buf& + 0), dstPos&, span&) = MID$(simplebuffer_array$(buf& + 0), srcPos&, span&)
        END IF
        newLen& = cbl& - (srcPos& - dstPos&)
        MID$(simplebuffer_array$(buf& + 1), 5, 4) = MKL$(newLen&)
        MID$(simplebuffer_array$(buf& + 1), 13, 4) = MKL$(-1)

        ' A line-ending change is more uncommon so we can get away with reducing
        ' the size if it's at least a 1/4 smaller, rather than half
        ext& = (((newLen& + 1) + 16383) AND -16384) '+1 = avoid zero case
        fsz& = LEN(simplebuffer_array$(buf& + 0)) - ext&
        IF fsz& >= LEN(simplebuffer_array$(buf& + 0)) \ 4 THEN
            simplebuffer_array$(buf& + 0) = LEFT$(simplebuffer_array$(buf& + 0), ext&)
        END IF
    END IF
    '--- set new EndOfLine mode & cursor position ---
    MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolL"
    MID$(simplebuffer_array$(buf& + 1), 1, 4) = MKL$(cur& - removed&)
END SUB

'--- docs\ConvBufToAnyEol.html
'---------------------------------------------------------------------
SUB ConvBufToWinEol (handle%)
    '--- option _explicit requirements ---
    DIM buf&, cbl&, cur&, srcPos&, dstPos&, span&, po&, breaks&, added&, newDat$
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- check current EndOfLine sequence ---
    IF MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolW" THEN EXIT SUB
    IF MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolN" AND LEN(BufEolSeq$(handle%)) = 2 THEN EXIT SUB
    IF MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolU" THEN ConvBufToLnxMacEol handle% 'safety measure for unknown (maybe mixed) EOL mode
    '--- prepare values ---
    cbl& = GetBufLen&(handle%): cur& = GetBufPos&(handle%)
    ' To make things faster we first calculate what the final string length
    ' will be, then we allocate that size and copy the string data into place
    srcPos& = 1
    DO
        po& = INSTR(srcPos&, simplebuffer_array$(buf& + 0), simplebuffer_lnxEol$)
        IF po& = 0 OR po& > cbl& THEN EXIT DO

        breaks& = breaks& + 1: IF po& < cur& THEN added& = added& + 1
        srcPos& = po& + 1
    LOOP

    ' Allocate the new string and copy the existing string data into place (with the new CRLF's)
    IF breaks& > 0 THEN
        newDat$ = SPACE$((((cbl& + breaks& + 1) + 16383) AND -16384)) '+1 = avoid zero case
        srcPos& = 1: dstPos& = 1
        DO
            po& = INSTR(srcPos&, simplebuffer_array$(buf& + 0), simplebuffer_lnxEol$)
            IF po& = 0 OR po& > cbl& THEN EXIT DO
            span& = po& - srcPos&
            IF span& > 0 THEN MID$(newDat$, dstPos&, span&) = MID$(simplebuffer_array$(buf& + 0), srcPos&, span&)
            dstPos& = dstPos& + span&
            MID$(newDat$, dstPos&, 2) = simplebuffer_winEol$: dstPos& = dstPos& + 2
            srcPos& = po& + 1
        LOOP
        span& = cbl& - srcPos& + 1
        IF span& > 0 THEN MID$(newDat$, dstPos&, span&) = MID$(simplebuffer_array$(buf& + 0), srcPos&, span&)
        simplebuffer_array$(buf& + 0) = newDat$
        MID$(simplebuffer_array$(buf& + 1), 5, 4) = MKL$(cbl& + breaks&)
        MID$(simplebuffer_array$(buf& + 1), 13, 4) = MKL$(-1)
    END IF
    '--- set new EndOfLine mode & cursor position ---
    MID$(simplebuffer_array$(buf& + 1), 9, 4) = "EolW"
    MID$(simplebuffer_array$(buf& + 1), 1, 4) = MKL$(cur& + added&)
END SUB

'--- undocumented - for internal use only
'---------------------------------------------------------------------
FUNCTION CheckHandle% (handle%)
    '--- option _explicit requirements ---
    DIM buf&
    '--- check handle ---
    buf& = handle% * simplebuffer_slots: CheckHandle% = 0
    IF buf& < 0 OR buf& > UBOUND(simplebuffer_array$) THEN EXIT FUNCTION
    IF LEN(simplebuffer_array$(buf& + 1)) = 0 THEN EXIT FUNCTION
    CheckHandle% = -1
END FUNCTION

'--- undocumented - for internal use only
'---------------------------------------------------------------------
FUNCTION VersionSimplebuffer$
    VersionSimplebuffer$ = MID$("$VER: simplebuffer.bm 3.2 (18-Oct-2022) by RhoSigma :END$", 7, 45)
END FUNCTION

'$INCLUDE: 'sb_qb64pe_extension.bm'

