' _ArrayCopy compiler helpers.
' Keep parsing, semantic resolution, validation, and C/C++ emission separated so
' each syntax form preserves BASIC evaluation order, diagnostics, and runtime
' behavior. Variable-length STRING copies snapshot qbs values before destination
' writes when overlap is possible; fixed-size payloads use bounds- and
' overflow-checked byte-copy paths.

FUNCTION ArrayCopyRefCaseLayout$ (expr AS STRING, whole_ref AS STRING)
    DIM AS STRING work_ref, resolver_ref, final_name, root_name, member_ref
    DIM AS STRING token_text, token_base, token_symbol, canonical_name, padded_name
    DIM AS LONG syntax_kind, has_member, ref_ok, ref_type
    DIM AS LONG id_number, member_id, ref_tokens, token_count
    DIM AS LONG final_open, depth_count, scan_at, prefix_end
    DIM AS LONG current_type, member_scan, token_at, group_depth

    ArrayCopyRefCaseLayout$ = CompactMemberRefLayout$(expr)

    resolver_ref = whole_ref
    ref_tokens = numelements(resolver_ref)
    IF ref_tokens < 3 THEN EXIT FUNCTION

    IF INSTR(resolver_ref, ".") THEN
        resolver_ref = getelements$(resolver_ref, 1, ref_tokens - 2)
        has_member = -1
        root_name = ""
    ELSE
        GetAsgRefSyntax resolver_ref, syntax_kind, final_name, has_member, root_name
        IF syntax_kind <> 2 OR has_member THEN EXIT FUNCTION
    END IF

    GetWholeAsgRef resolver_ref, root_name, has_member, ref_ok, member_ref, ref_type, id_number, member_id
    IF Error_Happened OR ref_ok = 0 THEN EXIT FUNCTION

    token_count = numelements(expr)
    IF token_count < 3 THEN EXIT FUNCTION
    IF getelement$(expr, token_count) <> ")" THEN EXIT FUNCTION

    depth_count = 1
    final_open = 0
    FOR scan_at = token_count - 1 TO 1 STEP -1
        token_text = getelement$(expr, scan_at)
        IF token_text = ")" THEN
            depth_count = depth_count + 1
        ELSEIF token_text = "(" THEN
            depth_count = depth_count - 1
            IF depth_count = 0 THEN final_open = scan_at: EXIT FOR
        END IF
    NEXT
    IF final_open <= 1 OR depth_count <> 0 THEN EXIT FUNCTION

    work_ref = expr

    'The outer _ArrayCopy TO is formatted by the statement layout. Canonicalize
    'only top-level TO separators inside the operand's final range group here.
    group_depth = 0
    FOR scan_at = final_open + 1 TO token_count - 1
        token_text = getelement$(work_ref, scan_at)
        IF token_text = "(" THEN
            group_depth = group_depth + 1
        ELSEIF token_text = ")" THEN
            group_depth = group_depth - 1
        ELSEIF group_depth = 0 AND UCASE$(token_text) = "TO" THEN
            removeelements work_ref, scan_at, scan_at, 0
            insertelements work_ref, scan_at - 1, SCase$("To")
        END IF
    NEXT

    prefix_end = final_open - 1

    getid id_number
    IF Error_Happened THEN EXIT FUNCTION

    token_text = getelement$(work_ref, 1)
    token_base = token_text
    token_symbol = removesymbol$(token_base)
    IF Error_Happened THEN EXIT FUNCTION
    canonical_name = RTRIM$(id.cn) + token_symbol
    removeelements work_ref, 1, 1, 0
    insertelements work_ref, 0, canonical_name

    IF id.arraytype THEN current_type = id.arraytype ELSE current_type = id.t

    token_at = 2
    DO WHILE token_at <= prefix_end
        token_text = getelement$(work_ref, token_at)

        IF token_text = "(" THEN
            group_depth = 1
            DO WHILE group_depth AND token_at < prefix_end
                token_at = token_at + 1
                token_text = getelement$(work_ref, token_at)
                IF token_text = "(" THEN group_depth = group_depth + 1
                IF token_text = ")" THEN group_depth = group_depth - 1
            LOOP
            IF group_depth <> 0 THEN EXIT FUNCTION

        ELSEIF token_text = "." THEN
            token_at = token_at + 1
            IF token_at > prefix_end THEN EXIT FUNCTION
            IF (current_type AND ISUDT) = 0 THEN EXIT FUNCTION

            token_text = getelement$(work_ref, token_at)
            token_base = token_text
            token_symbol = removesymbol$(token_base)
            IF Error_Happened THEN EXIT FUNCTION
            padded_name = UCASE$(token_base) + SPACE$(256 - LEN(token_base))

            member_scan = udtxnext(current_type AND UDTMASK)
            DO WHILE member_scan
                IF udtename(member_scan) = padded_name THEN EXIT DO
                member_scan = udtenext(member_scan)
            LOOP
            IF member_scan = 0 THEN EXIT FUNCTION

            canonical_name = RTRIM$(udtecname(member_scan)) + token_symbol
            removeelements work_ref, token_at, token_at, 0
            insertelements work_ref, token_at - 1, canonical_name
            current_type = udtetype(member_scan)
        END IF

        token_at = token_at + 1
    LOOP

    ArrayCopyRefCaseLayout$ = CompactMemberRefLayout$(work_ref)
END FUNCTION



'Emit the ownership-safe linear qbs snapshot loop shared by whole-array
'variable-length STRING copies. Allocation, self-copy guarding, destination
'mapping, write-back, and cleanup deliberately remain in the callers.
SUB AppendArrayCopyVarStringLinearSnapshot (src_expr AS STRING)
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_total;array_copy_i++){"
    WriteBufLine MainTxtBuf, "array_copy_tmp[array_copy_i]=qbs_new(0,0);"
    WriteBufLine MainTxtBuf, "if (array_copy_tmp[array_copy_i]) array_copy_tmp_made++;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_tmp[array_copy_i])||is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "qbs_set(array_copy_tmp[array_copy_i]," + src_expr + ");"
    WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit a multidimensional whole-array variable-length STRING copy. Supported
'variable-length STRING arrays use qbs* element slots for top-level, inline/_Static,
'and descriptor-backed _Dynamic storage.

SUB AppendArrayCopyWholeVarString (dstarr AS STRING, srcarr AS STRING, arrdims AS LONG, dst_slot_mode AS LONG, src_slot_mode AS LONG)
    DIM srcslot AS STRING
    DIM dstslot AS STRING

    IF arrdims <= 1 THEN Give_Error "_ArrayCopy multidimensional variable-length STRING copy requires at least two dimensions": EXIT SUB
    IF src_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine source variable-length STRING storage": EXIT SUB
    IF dst_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine destination variable-length STRING storage": EXIT SUB

    srcslot = "((qbs**)array_copy_src[0])[array_copy_i]"
    dstslot = "((qbs**)array_copy_dst[0])[array_copy_i]"

    WriteBufLine MainTxtBuf, "{"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dstarr + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + srcarr + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_total=1;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_dst)||(!array_copy_src)||!(array_copy_dst[2]&1)||!(array_copy_src[2]&1)||(!array_copy_dst[0])||(!array_copy_src[0])||(array_copy_dst[0]==(ptrszint)nothingvalue)||(array_copy_src[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1;array_copy_dim<=" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "ptrszint array_copy_arg=(" + _TOSTR$(arrdims) + "-array_copy_dim)*4+4;"
    WriteBufLine MainTxtBuf, "if ((array_copy_dst[array_copy_arg]!=array_copy_src[array_copy_arg])||(array_copy_dst[array_copy_arg+1]!=array_copy_src[array_copy_arg+1])){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "if (array_copy_dst[array_copy_arg+1]<0){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "if (array_copy_dst[array_copy_arg+1]&&array_copy_total>(18446744073709551615ull/(uint64)array_copy_dst[array_copy_arg+1])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_total*=(uint64)array_copy_dst[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_dst[0]!=array_copy_src[0])){"
    WriteBufLine MainTxtBuf, "if (array_copy_total>((uint64)(~(size_t)0)/sizeof(qbs*))){error(257);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "qbs **array_copy_tmp=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_tmp_made=0;"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_total){array_copy_tmp=(qbs**)malloc((size_t)(array_copy_total*sizeof(qbs*)));if (!array_copy_tmp){error(257);array_copy_ok=0;}}"
    AppendArrayCopyVarStringLinearSnapshot srcslot
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_total;array_copy_i++){"
    WriteBufLine MainTxtBuf, "qbs_set(" + dstslot + ",array_copy_tmp[array_copy_i]);"
    WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_tmp_made;array_copy_i++) qbs_free(array_copy_tmp[array_copy_i]);"
    WriteBufLine MainTxtBuf, "free(array_copy_tmp);"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB



'Emit the mapped destination-write and cleanup tail shared by multidimensional
'variable-length STRING whole-to-start and range-mapped copies. The caller
'supplies the generated-C count expression for the current dimension.
'All generated loops and cleanup remain entirely inside this helper.
SUB AppendArrayCopyVarStringMappedTail (arrdims AS LONG, count_expr AS STRING)
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_total;array_copy_i++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_quotient=array_copy_i;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_element=0;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_coord=array_copy_quotient%" + count_expr + ";"
    WriteBufLine MainTxtBuf, "array_copy_quotient/=" + count_expr + ";"
    WriteBufLine MainTxtBuf, "array_copy_dst_element+=(array_copy_dst_offset[array_copy_dim]+array_copy_coord)*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "qbs_set(((qbs**)array_copy_dst[0])[array_copy_dst_element],array_copy_tmp[array_copy_i]);"
    WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_tmp_made;array_copy_i++) qbs_free(array_copy_tmp[array_copy_i]);"
    WriteBufLine MainTxtBuf, "free(array_copy_tmp);"
END SUB


'Emit a multidimensional variable-length STRING whole-to-start copy. The source
'shape is mapped to the requested destination coordinates. A complete qbs
'snapshot is made before the first destination write, so top-level, inline,
'_Static, and descriptor-backed _Dynamic arrays may be mixed safely. Supported
'variable-length STRING operands use qbs* element slots.
SUB AppendArrayCopyWholeAtVarString (dstarr AS STRING, srcarr AS STRING, arrdims AS LONG, dst_start_init AS STRING, dst_slot_mode AS LONG, src_slot_mode AS LONG)
    IF arrdims <= 1 THEN Give_Error "_ArrayCopy multidimensional variable-length STRING whole-to-start requires at least two dimensions": EXIT SUB
    IF src_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine source variable-length STRING storage": EXIT SUB
    IF dst_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine destination variable-length STRING storage": EXIT SUB

    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start[" + _TOSTR$(arrdims) + "]={" + dst_start_init + "};"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + srcarr + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dstarr + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_count[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_count[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_stride[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_total=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_total=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "ptrszint array_copy_arg=(" + _TOSTR$(arrdims) + "-1-array_copy_dim)*4+4;"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_elements=(int64)array_copy_src[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_elements=(int64)array_copy_dst[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[array_copy_arg];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_elements<=0)||(array_copy_dst_elements<=0)||(array_copy_dst_start[array_copy_dim]<array_copy_dst_lower)){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_count[array_copy_dim]=(uint64)array_copy_src_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_count[array_copy_dim]=(uint64)array_copy_dst_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset[array_copy_dim]=(uint64)array_copy_dst_start[array_copy_dim]-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((array_copy_dst_offset[array_copy_dim]>=array_copy_dst_count[array_copy_dim])||(array_copy_src_count[array_copy_dim]>(array_copy_dst_count[array_copy_dim]-array_copy_dst_offset[array_copy_dim]))){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "if (array_copy_total>(18446744073709551615ull/array_copy_src_count[array_copy_dim])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_total*=array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_total>(18446744073709551615ull/array_copy_dst_count[array_copy_dim])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_total*=array_copy_dst_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[0]=1;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_dst_count[array_copy_dim-1])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[array_copy_dim]=array_copy_dst_stride[array_copy_dim-1]*array_copy_dst_count[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_last_coord=array_copy_dst_offset[array_copy_dim]+array_copy_src_count[array_copy_dim]-1;"
    WriteBufLine MainTxtBuf, "if (array_copy_last_coord&&(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_last_coord))){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_term=array_copy_last_coord*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_last>(18446744073709551615ull-array_copy_term)){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_last+=array_copy_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_dst_last>=array_copy_dst_total){error(9);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_total>((uint64)(~(size_t)0)/sizeof(qbs*)))){error(257);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "qbs **array_copy_tmp=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_tmp_made=0;"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_total){array_copy_tmp=(qbs**)malloc((size_t)(array_copy_total*sizeof(qbs*)));if (!array_copy_tmp){error(257);array_copy_ok=0;}}"
    AppendArrayCopyVarStringLinearSnapshot "((qbs**)array_copy_src[0])[array_copy_i]"
    AppendArrayCopyVarStringMappedTail arrdims, "array_copy_src_count[array_copy_dim]"
END SUB


'Emit a multidimensional variable-length STRING range-to-start copy. Each
'selected source coordinate is mapped to the matching destination coordinate.
'A complete qbs snapshot is made before the first destination write, so all
'top-level, inline, _Static, and descriptor-backed _Dynamic combinations remain
'ownership-safe even when source and destination overlap. Supported
'variable-length STRING operands use qbs* element slots.
SUB AppendArrayCopyRangeAtVarString (dstarr AS STRING, srcarr AS STRING, arrdims AS LONG, src_low_init AS STRING, src_high_init AS STRING, dst_start_init AS STRING, dst_slot_mode AS LONG, src_slot_mode AS LONG)
    IF arrdims <= 1 THEN Give_Error "_ArrayCopy multidimensional variable-length STRING range-to-start requires at least two dimensions": EXIT SUB
    IF src_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine source variable-length STRING storage": EXIT SUB
    IF dst_slot_mode = 0 THEN Give_Error "_ArrayCopy cannot determine destination variable-length STRING storage": EXIT SUB

    WriteBufLine MainTxtBuf, "int64 array_copy_src_low[" + _TOSTR$(arrdims) + "]={" + src_low_init + "};"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_high[" + _TOSTR$(arrdims) + "]={" + src_high_init + "};"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start[" + _TOSTR$(arrdims) + "]={" + dst_start_init + "};"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + srcarr + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dstarr + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_total[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_total[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_count[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_offset[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_stride[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_stride[" + _TOSTR$(arrdims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_total=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_storage_total=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_storage_total=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_last=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "ptrszint array_copy_arg=(" + _TOSTR$(arrdims) + "-1-array_copy_dim)*4+4;"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_lower=(int64)array_copy_src[array_copy_arg];"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_elements=(int64)array_copy_src[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[array_copy_arg];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_elements=(int64)array_copy_dst[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_elements<=0)||(array_copy_dst_elements<=0)||(array_copy_src_low[array_copy_dim]>array_copy_src_high[array_copy_dim])||(array_copy_src_low[array_copy_dim]<array_copy_src_lower)||(array_copy_dst_start[array_copy_dim]<array_copy_dst_lower)){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_total[array_copy_dim]=(uint64)array_copy_src_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_total[array_copy_dim]=(uint64)array_copy_dst_elements;"
    WriteBufLine MainTxtBuf, "array_copy_count[array_copy_dim]=(uint64)array_copy_src_high[array_copy_dim]-(uint64)array_copy_src_low[array_copy_dim]+1;"
    WriteBufLine MainTxtBuf, "array_copy_src_offset[array_copy_dim]=(uint64)array_copy_src_low[array_copy_dim]-(uint64)array_copy_src_lower;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset[array_copy_dim]=(uint64)array_copy_dst_start[array_copy_dim]-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_count[array_copy_dim])||(array_copy_src_offset[array_copy_dim]>=array_copy_src_total[array_copy_dim])||(array_copy_count[array_copy_dim]>(array_copy_src_total[array_copy_dim]-array_copy_src_offset[array_copy_dim]))||(array_copy_dst_offset[array_copy_dim]>=array_copy_dst_total[array_copy_dim])||(array_copy_count[array_copy_dim]>(array_copy_dst_total[array_copy_dim]-array_copy_dst_offset[array_copy_dim]))){error(9);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "if (array_copy_total>(18446744073709551615ull/array_copy_count[array_copy_dim])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_total*=array_copy_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_src_storage_total>(18446744073709551615ull/array_copy_src_total[array_copy_dim])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_storage_total*=array_copy_src_total[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_storage_total>(18446744073709551615ull/array_copy_dst_total[array_copy_dim])){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_storage_total*=array_copy_dst_total[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_src_stride[0]=1;"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[0]=1;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_src_total[array_copy_dim-1]))||(array_copy_dst_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_dst_total[array_copy_dim-1]))){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_stride[array_copy_dim]=array_copy_src_stride[array_copy_dim-1]*array_copy_src_total[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[array_copy_dim]=array_copy_dst_stride[array_copy_dim-1]*array_copy_dst_total[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_last_coord=array_copy_src_offset[array_copy_dim]+array_copy_count[array_copy_dim]-1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last_coord=array_copy_dst_offset[array_copy_dim]+array_copy_count[array_copy_dim]-1;"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_last_coord&&(array_copy_src_stride[array_copy_dim]>(18446744073709551615ull/array_copy_src_last_coord)))||(array_copy_dst_last_coord&&(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_dst_last_coord)))){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_term=array_copy_src_last_coord*array_copy_src_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_term=array_copy_dst_last_coord*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_last>(18446744073709551615ull-array_copy_src_term))||(array_copy_dst_last>(18446744073709551615ull-array_copy_dst_term))){error(257);array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_last+=array_copy_src_term;"
    WriteBufLine MainTxtBuf, "array_copy_dst_last+=array_copy_dst_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&((array_copy_src_last>=array_copy_src_storage_total)||(array_copy_dst_last>=array_copy_dst_storage_total))){error(9);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_total>((uint64)(~(size_t)0)/sizeof(qbs*)))){error(257);array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "qbs **array_copy_tmp=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_tmp_made=0;"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_total){array_copy_tmp=(qbs**)malloc((size_t)(array_copy_total*sizeof(qbs*)));if (!array_copy_tmp){error(257);array_copy_ok=0;}}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_total;array_copy_i++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_quotient=array_copy_i;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_element=0;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0;array_copy_dim<" + _TOSTR$(arrdims) + ";array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_coord=array_copy_quotient%array_copy_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_quotient/=array_copy_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_src_element+=(array_copy_src_offset[array_copy_dim]+array_copy_coord)*array_copy_src_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "array_copy_tmp[array_copy_i]=qbs_new(0,0);"
    WriteBufLine MainTxtBuf, "if (array_copy_tmp[array_copy_i]) array_copy_tmp_made++;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_tmp[array_copy_i])||is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "qbs_set(array_copy_tmp[array_copy_i],((qbs**)array_copy_src[0])[array_copy_src_element]);"
    WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    AppendArrayCopyVarStringMappedTail arrdims, "array_copy_count[array_copy_dim]"
END SUB


'Parse one syntactic array reference used by _ArrayCopy. Semantic resolution is
'deliberately deferred to the ResolveArrayCopyRefEx resolver layer so unsupported
'_Dynamic members and multidimensional members reach their specific diagnostics
'instead of being collapsed into the generic _ArrayCopy syntax error here.
'ref_kind = -1 requires array(lower TO upper).
'ref_kind = 0 requires array(start).
'ref_kind = 1 requires array().
'ref_kind = 2 requires array(start1, start2, ...).
'ref_kind = 3 requires array(lower1 TO upper1, lower2 TO upper2, ...).
SUB ParseArrayCopyRef (expr AS STRING, ref_kind AS LONG, arr_ref AS STRING, first_expr AS STRING, second_expr AS STRING, ref_ok AS LONG)
    DIM AS STRING token_text, whole_ref
    DIM AS LONG token_count, scan_at, depth_count, open_at, split_at, comma_count

    arr_ref = ""
    first_expr = ""
    second_expr = ""
    ref_ok = 0

    token_count = numelements(expr)
    IF token_count < 3 THEN EXIT SUB
    IF getelement$(expr, token_count) <> ")" THEN EXIT SUB

    'Find the opening parenthesis of the final array group. Parent array indexes
    'and nested member chains remain part of the reference prefix.
    depth_count = 1
    open_at = 0
    FOR scan_at = token_count - 1 TO 1 STEP -1
        token_text = getelement$(expr, scan_at)
        IF token_text = ")" THEN
            depth_count = depth_count + 1
        ELSEIF token_text = "(" THEN
            depth_count = depth_count - 1
            IF depth_count = 0 THEN open_at = scan_at: EXIT FOR
        END IF
    NEXT
    IF open_at <= 1 OR depth_count <> 0 THEN EXIT SUB

    whole_ref = getelements$(expr, 1, open_at - 1) + sp + "(" + sp + ")"
    arr_ref = whole_ref

    IF ref_kind = 1 THEN
        IF open_at <> token_count - 1 THEN EXIT SUB
        ref_ok = -1
        EXIT SUB
    END IF

    IF open_at >= token_count - 1 THEN EXIT SUB

    depth_count = 0
    split_at = 0
    FOR scan_at = open_at + 1 TO token_count - 1
        token_text = UCASE$(getelement$(expr, scan_at))
        IF token_text = "(" THEN
            depth_count = depth_count + 1
        ELSEIF token_text = ")" THEN
            depth_count = depth_count - 1
            IF depth_count < 0 THEN EXIT SUB
        ELSEIF depth_count = 0 THEN
            IF token_text = "," THEN
                IF ref_kind <> 2 AND ref_kind <> 3 THEN EXIT SUB
                IF ref_kind = 3 THEN comma_count = comma_count + 1
            ELSEIF token_text = "TO" THEN
                IF ref_kind = 2 THEN EXIT SUB
                IF ref_kind = -1 THEN
                    IF split_at THEN EXIT SUB
                    split_at = scan_at
                ELSEIF ref_kind <> 3 THEN
                    EXIT SUB
                END IF
            END IF
        END IF
    NEXT
    IF depth_count <> 0 THEN EXIT SUB

    IF ref_kind = -1 THEN
        IF split_at = 0 THEN EXIT SUB
        IF split_at = open_at + 1 OR split_at = token_count - 1 THEN EXIT SUB
        first_expr = getelements$(expr, open_at + 1, split_at - 1)
        second_expr = getelements$(expr, split_at + 1, token_count - 1)
    ELSEIF ref_kind = 0 OR ref_kind = 2 THEN
        IF split_at THEN EXIT SUB
        first_expr = getelements$(expr, open_at + 1, token_count - 1)
    ELSEIF ref_kind = 3 THEN
        IF comma_count = 0 THEN EXIT SUB
        first_expr = getelements$(expr, open_at + 1, token_count - 1)
    ELSE
        EXIT SUB
    END IF

    IF first_expr = "" THEN EXIT SUB
    IF ref_kind = -1 AND second_expr = "" THEN EXIT SUB
    ref_ok = -1
END SUB


'Resolve a whole-array spelling used by _ArrayCopy. Top-level arrays retain their
'normal descriptor. Inline TYPE member arrays use BuildUDTMemberArg so scalar,
'indexed-parent and nested member references all share the established address path.
SUB ResolveArrayCopyRefEx (whole_ref AS STRING, role_text AS STRING, desc_text AS STRING, prep_text AS STRING, arr_type AS LONG, arr_size AS LONG, dim_count AS LONG, allow_dynamic_var_string AS LONG, string_slot_mode AS LONG)
    DIM AS STRING final_name, root_name, member_ref, resolver_ref
    DIM AS LONG syntax_kind, has_member, ref_ok, ref_type
    DIM AS LONG id_number, member_id, ref_tokens, member_candidate

    desc_text = ""
    prep_text = ""
    arr_type = 0
    arr_size = 0
    dim_count = 0
    string_slot_mode = 0

    'ParseArrayCopyRef has already verified the final whole-array (). Detect a
    'TYPE-member chain before the generic spelling classifier. Member-array
    'identity is resolved semantically by GetWholeAsgRef/evaluate, using the
    'established bare-member spelling also used by assignment and ERASE.
    resolver_ref = whole_ref
    ref_tokens = numelements(resolver_ref)
    IF ref_tokens < 3 THEN Give_Error "_ArrayCopy " + role_text + " must be an array": EXIT SUB
    IF getelement$(resolver_ref, ref_tokens - 1) <> "(" OR getelement$(resolver_ref, ref_tokens) <> ")" THEN
        Give_Error "_ArrayCopy " + role_text + " must be an array": EXIT SUB
    END IF

    member_candidate = 0
    IF INSTR(resolver_ref, ".") THEN member_candidate = -1

    IF member_candidate THEN
        'ParseArrayCopyRef already proved the explicit final (). Do not pass a TYPE
        'member through GetAsgRefSyntax again: member-array identity is semantic,
        'and GetWholeAsgRef/evaluate is the established resolver used by assignment.
        resolver_ref = getelements$(resolver_ref, 1, ref_tokens - 2)
        has_member = -1
        root_name = ""
    ELSE
        GetAsgRefSyntax resolver_ref, syntax_kind, final_name, has_member, root_name
        IF syntax_kind <> 2 THEN Give_Error "_ArrayCopy " + role_text + " must be an array": EXIT SUB
        IF has_member THEN Give_Error "_ArrayCopy " + role_text + " must be an array": EXIT SUB
    END IF

    GetWholeAsgRef resolver_ref, root_name, has_member, ref_ok, member_ref, ref_type, id_number, member_id
    IF Error_Happened THEN EXIT SUB
    IF ref_ok = 0 THEN Give_Error "_ArrayCopy " + role_text + " must be an array": EXIT SUB

    IF member_id = 0 THEN
        getid id_number
        IF Error_Happened THEN EXIT SUB
        desc_text = RTRIM$(id.callname)
        arr_type = id.arraytype
        arr_size = id.tsize
        dim_count = id.arrayelements
        IF dim_count <= 0 THEN dim_count = arrayelementslist(id_number)
        IF (arr_type AND ISSTRING) <> 0 AND (arr_type AND ISFIXEDLENGTH) = 0 THEN string_slot_mode = -1
        EXIT SUB
    END IF

    'Variable-length STRING array elements use qbs* slots for top-level arrays,
    'inline/_Static members, and descriptor-backed _Dynamic members. Keep the allow
    'flag in the resolver contract so callers can explicitly reject descriptor-backed
    'variable-length STRING members when required.
    IF (udtetype(member_id) AND ISSTRING) <> 0 AND (udtetype(member_id) AND ISFIXEDLENGTH) = 0 THEN
        IF UDTMemberDynDesc%(member_id) AND allow_dynamic_var_string = 0 THEN
            Give_Error "_ArrayCopy variable-length STRING arrays are not supported yet"
            EXIT SUB
        END IF
        string_slot_mode = -1
    END IF

    BuildUDTMemberArg member_ref, desc_text, prep_text, dim_count
    IF Error_Happened THEN EXIT SUB
    arr_type = udtetype(member_id)
    arr_size = udtetypesize(member_id)
END SUB


'Compatibility wrapper for callers that intentionally keep descriptor-backed
'variable-length _Dynamic STRING members disabled.
SUB ResolveArrayCopyRef (whole_ref AS STRING, role_text AS STRING, desc_text AS STRING, prep_text AS STRING, arr_type AS LONG, arr_size AS LONG, dim_count AS LONG)
    DIM string_slot_mode AS LONG

    ResolveArrayCopyRefEx whole_ref, role_text, desc_text, prep_text, arr_type, arr_size, dim_count, 0, string_slot_mode
END SUB


'Resolve the source/destination pair used by every active _ArrayCopy emitter.
'Keep source resolution first and stop immediately on a source error so the
'existing role-specific diagnostics and error ordering remain unchanged. Both
'operands opt into descriptor-backed variable-length STRING support exactly as
'the emitters did before this helper; this routine changes only compiler-side
'deduplication and does not alter emitted C/C++ or ownership behavior.
SUB ResolveArrayCopyPairEx (src_ref AS STRING, dst_ref AS STRING, src_desc AS STRING, src_prep AS STRING, src_type AS LONG, src_size AS LONG, src_dims AS LONG, src_string_slot_mode AS LONG, dst_desc AS STRING, dst_prep AS STRING, dst_type AS LONG, dst_size AS LONG, dst_dims AS LONG, dst_string_slot_mode AS LONG)
    ResolveArrayCopyRefEx src_ref, "source", src_desc, src_prep, src_type, src_size, src_dims, -1, src_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    ResolveArrayCopyRefEx dst_ref, "destination", dst_desc, dst_prep, dst_type, dst_size, dst_dims, -1, dst_string_slot_mode
END SUB


'Return true when an _ArrayCopy element type is a variable-length STRING.
'Keep this classification in one place so every emitter uses the same type test
'without moving any form-specific rank, storage or diagnostic policy.
FUNCTION ArrayCopyIsVarString% (arr_type AS LONG)
    ArrayCopyIsVarString% = 0
    IF (arr_type AND ISSTRING) = 0 THEN EXIT FUNCTION
    IF (arr_type AND ISFIXEDLENGTH) <> 0 THEN EXIT FUNCTION
    ArrayCopyIsVarString% = -1
END FUNCTION


'Validate the element type/size contract shared by all _ArrayCopy forms after
'their dimension policy has been checked by the caller. Keeping rank checks in
'the pair validators preserves exact diagnostics and error order.
SUB CheckArrayCopyElementPair (src_type AS LONG, src_size AS LONG, dst_type AS LONG, dst_size AS LONG, element_bytes AS LONG)
    DIM AS LONG src_compare, dst_compare, element_bits

    element_bytes = 0
    src_compare = src_type AND (ISFLOAT + ISUDT + UDTMASK + ISUNSIGNED + ISSTRING + ISFIXEDLENGTH + ISOFFSET + ISOFFSETINBITS)
    dst_compare = dst_type AND (ISFLOAT + ISUDT + UDTMASK + ISUNSIGNED + ISSTRING + ISFIXEDLENGTH + ISOFFSET + ISOFFSETINBITS)
    IF src_compare <> dst_compare THEN
        Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
    END IF

    IF src_compare AND ISSTRING THEN
        IF (src_compare AND ISFIXEDLENGTH) = 0 THEN
            Give_Error "_ArrayCopy variable-length STRING arrays are not supported yet": EXIT SUB
        END IF
        IF src_size <= 0 OR dst_size <= 0 THEN
            Give_Error "_ArrayCopy cannot determine the fixed-length STRING element size": EXIT SUB
        END IF
        IF src_size <> dst_size THEN
            Give_Error "_ArrayCopy requires fixed-length STRING arrays with the same element size": EXIT SUB
        END IF
        element_bytes = src_size
        EXIT SUB
    END IF

    IF src_compare AND (ISUDT + ISOFFSETINBITS) THEN
        Give_Error "_ArrayCopy supports only byte-aligned numeric or fixed-length STRING arrays": EXIT SUB
    END IF

    element_bits = src_compare AND UDTMASK
    IF element_bits <= 0 OR element_bits MOD 8 THEN
        Give_Error "_ArrayCopy cannot determine a byte-aligned element size": EXIT SUB
    END IF
    element_bytes = element_bits \ 8
END SUB


'Validate the common one-dimensional element contract after both
'top-level/member references have been resolved.
SUB CheckArrayCopyPair (src_type AS LONG, src_size AS LONG, src_dims AS LONG, dst_type AS LONG, dst_size AS LONG, dst_dims AS LONG, element_bytes AS LONG)
    element_bytes = 0
    IF src_dims <> 1 OR dst_dims <> 1 THEN
        Give_Error "_ArrayCopy TYPE-member step supports only one-dimensional arrays": EXIT SUB
    END IF

    CheckArrayCopyElementPair src_type, src_size, dst_type, dst_size, element_bytes
END SUB


'Validate the common one-dimensional pair policy used by the three 1D emitters.
'Variable-length STRING arrays require native qbs* slot storage; all other
'element types reuse CheckArrayCopyPair.
SUB CheckArrayCopy1DPair (src_type AS LONG, src_size AS LONG, src_dims AS LONG, src_string_slot_mode AS LONG, dst_type AS LONG, dst_size AS LONG, dst_dims AS LONG, dst_string_slot_mode AS LONG, element_bytes AS LONG, var_string_copy AS LONG)
    DIM AS LONG src_var_string, dst_var_string

    src_var_string = ArrayCopyIsVarString%(src_type)
    dst_var_string = ArrayCopyIsVarString%(dst_type)
    var_string_copy = 0

    IF src_var_string OR dst_var_string THEN
        IF src_var_string = 0 OR dst_var_string = 0 THEN
            Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
        END IF
        IF src_dims <> 1 OR dst_dims <> 1 THEN
            Give_Error "_ArrayCopy variable-length STRING step supports only one-dimensional arrays": EXIT SUB
        END IF
        IF src_string_slot_mode = 0 OR dst_string_slot_mode = 0 THEN
            Give_Error "_ArrayCopy cannot determine variable-length STRING storage": EXIT SUB
        END IF
        var_string_copy = -1
    ELSE
        CheckArrayCopyPair src_type, src_size, src_dims, dst_type, dst_size, dst_dims, element_bytes
    END IF
END SUB


'Validate the common pair policy used by multidimensional source-range forms.
'Variable-length STRING pairs must both be multidimensional, have matching rank,
'and expose a known qbs* slot representation. Fixed-size payloads retain the
'existing whole-pair validation. Form-specific range parsing remains in callers.
SUB CheckArrayCopyRangeNDPair (src_type AS LONG, src_size AS LONG, src_dims AS LONG, src_string_slot_mode AS LONG, dst_type AS LONG, dst_size AS LONG, dst_dims AS LONG, dst_string_slot_mode AS LONG, element_bytes AS LONG, var_string_copy AS LONG)
    DIM AS LONG src_var_string, dst_var_string

    src_var_string = ArrayCopyIsVarString%(src_type)
    dst_var_string = ArrayCopyIsVarString%(dst_type)
    var_string_copy = 0

    IF src_var_string OR dst_var_string THEN
        IF src_var_string = 0 OR dst_var_string = 0 THEN
            Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
        END IF
        IF src_dims <= 1 OR dst_dims <= 1 OR src_dims <> dst_dims THEN
            Give_Error "_ArrayCopy source and destination must have the same multidimensional shape rank": EXIT SUB
        END IF
        IF src_string_slot_mode = 0 OR dst_string_slot_mode = 0 THEN
            Give_Error "_ArrayCopy cannot determine variable-length STRING storage": EXIT SUB
        END IF
        var_string_copy = -1
    ELSE
        CheckArrayCopyWholePair src_type, src_size, src_dims, dst_type, dst_size, dst_dims, element_bytes
    END IF
END SUB


'Compile a one-dimensional source range in the same low-then-high order used
'by the original emitters. Each BASIC expression is normalized and evaluated once.
SUB ParseArrayCopySourceRange1D (src_low_expr AS STRING, src_high_expr AS STRING, src_low_code AS STRING, src_high_code AS STRING)
    DIM AS STRING src_low_work, src_high_work

    src_low_work = fixoperationorder$(src_low_expr)
    IF Error_Happened THEN EXIT SUB
    src_low_code = evaluatetotyp(src_low_work, 64&)
    IF Error_Happened THEN EXIT SUB

    src_high_work = fixoperationorder$(src_high_expr)
    IF Error_Happened THEN EXIT SUB
    src_high_code = evaluatetotyp(src_high_work, 64&)
    IF Error_Happened THEN EXIT SUB
END SUB


'Compile the one-dimensional destination start expression shared by range-at
'and whole-at emitters. The BASIC expression is normalized and evaluated once;
'callers retain their original source-before-destination evaluation order.
SUB ParseArrayCopyDestinationStart1D (dst_start_expr AS STRING, dst_start_code AS STRING)
    DIM dst_start_work AS STRING

    dst_start_work = fixoperationorder$(dst_start_expr)
    IF Error_Happened THEN EXIT SUB
    dst_start_code = evaluatetotyp(dst_start_work, 64&)
    IF Error_Happened THEN EXIT SUB
END SUB


'Parse and compile the multidimensional source-range list shared by both ND
'range emitters. The helper deliberately preserves the original left-to-right
'evaluation order, exact diagnostics, and one-time evaluation of every lower
'and upper BASIC expression. Callers keep their form-specific rank policy and
'destination behavior; this routine only produces the C initializer fragments.
SUB ParseArrayCopySourceRanges (src_range_list AS STRING, src_dims AS LONG, low_init AS STRING, high_init AS STRING)
    DIM AS STRING range_token, range_part, low_expr, high_expr
    DIM AS STRING low_work, high_work, low_code, high_code
    DIM AS LONG range_tokens, range_at, range_depth, range_begin, range_count, range_cut
    DIM AS LONG part_tokens, part_at, part_depth, to_at

    range_tokens = numelements(src_range_list)
    IF range_tokens <= 0 THEN Give_Error "_ArrayCopy source requires one lower TO upper range per dimension": EXIT SUB

    range_depth = 0
    range_begin = 1
    range_count = 0
    low_init = ""
    high_init = ""

    FOR range_at = 1 TO range_tokens + 1
        range_cut = 0
        IF range_at > range_tokens THEN
            range_cut = -1
        ELSE
            range_token = getelement$(src_range_list, range_at)
            IF range_token = "(" THEN
                range_depth = range_depth + 1
            ELSEIF range_token = ")" THEN
                range_depth = range_depth - 1
                IF range_depth < 0 THEN Give_Error "_ArrayCopy source range expression has unmatched parentheses": EXIT SUB
            ELSEIF range_depth = 0 AND range_token = "," THEN
                range_cut = -1
            END IF
        END IF

        IF range_cut THEN
            IF range_at <= range_begin THEN Give_Error "_ArrayCopy source range expression cannot be empty": EXIT SUB
            range_part = getelements$(src_range_list, range_begin, range_at - 1)
            IF range_part = "" THEN Give_Error "_ArrayCopy source range expression cannot be empty": EXIT SUB

            part_tokens = numelements(range_part)
            part_depth = 0
            to_at = 0
            FOR part_at = 1 TO part_tokens
                range_token = UCASE$(getelement$(range_part, part_at))
                IF range_token = "(" THEN
                    part_depth = part_depth + 1
                ELSEIF range_token = ")" THEN
                    part_depth = part_depth - 1
                    IF part_depth < 0 THEN Give_Error "_ArrayCopy source range expression has unmatched parentheses": EXIT SUB
                ELSEIF part_depth = 0 AND range_token = "TO" THEN
                    IF to_at THEN Give_Error "_ArrayCopy source dimension requires exactly one TO": EXIT SUB
                    to_at = part_at
                END IF
            NEXT
            IF part_depth <> 0 THEN Give_Error "_ArrayCopy source range expression has unmatched parentheses": EXIT SUB
            IF to_at <= 1 OR to_at >= part_tokens THEN Give_Error "_ArrayCopy source dimension requires lower TO upper": EXIT SUB

            low_expr = getelements$(range_part, 1, to_at - 1)
            high_expr = getelements$(range_part, to_at + 1, part_tokens)
            IF low_expr = "" OR high_expr = "" THEN Give_Error "_ArrayCopy source dimension requires lower TO upper": EXIT SUB

            low_work = fixoperationorder$(low_expr)
            IF Error_Happened THEN EXIT SUB
            low_code = evaluatetotyp(low_work, 64&)
            IF Error_Happened THEN EXIT SUB

            high_work = fixoperationorder$(high_expr)
            IF Error_Happened THEN EXIT SUB
            high_code = evaluatetotyp(high_work, 64&)
            IF Error_Happened THEN EXIT SUB

            range_count = range_count + 1
            IF low_init <> "" THEN low_init = low_init + ","
            IF high_init <> "" THEN high_init = high_init + ","
            low_init = low_init + "(int64)(" + low_code + ")"
            high_init = high_init + "(int64)(" + high_code + ")"
            range_begin = range_at + 1
        END IF
    NEXT

    IF range_depth <> 0 THEN Give_Error "_ArrayCopy source range expression has unmatched parentheses": EXIT SUB
    IF range_count <> src_dims THEN Give_Error "_ArrayCopy source range count must match source dimensions": EXIT SUB
END SUB


'Parse the destination start-coordinate list shared by whole-at and range-at ND
'emitters. compile_coords controls whether BASIC expressions are compiled here.
'WholeAtND deliberately passes zero for its 1D defer path so the raw first
'coordinate remains unevaluated until EmitArrayCopyWholeAt1D handles it, exactly
'as before. ND callers pass -1 and receive the C initializer fragment.
SUB ParseArrayCopyDestinationStarts (dst_start_list AS STRING, dst_dims AS LONG, compile_coords AS LONG, coord_init AS STRING, first_coord AS STRING)
    DIM AS STRING coord_token, coord_expr, coord_work, coord_code
    DIM AS LONG coord_tokens, coord_at, coord_depth, coord_begin, coord_count, coord_cut

    coord_tokens = numelements(dst_start_list)
    IF coord_tokens <= 0 THEN Give_Error "_ArrayCopy destination requires one start coordinate per dimension": EXIT SUB

    coord_depth = 0
    coord_begin = 1
    coord_count = 0
    coord_init = ""
    first_coord = ""

    FOR coord_at = 1 TO coord_tokens + 1
        coord_cut = 0
        IF coord_at > coord_tokens THEN
            coord_cut = -1
        ELSE
            coord_token = getelement$(dst_start_list, coord_at)
            IF coord_token = "(" THEN
                coord_depth = coord_depth + 1
            ELSEIF coord_token = ")" THEN
                coord_depth = coord_depth - 1
                IF coord_depth < 0 THEN Give_Error "_ArrayCopy destination coordinate expression has unmatched parentheses": EXIT SUB
            ELSEIF coord_depth = 0 AND coord_token = "," THEN
                coord_cut = -1
            END IF
        END IF

        IF coord_cut THEN
            IF coord_at <= coord_begin THEN Give_Error "_ArrayCopy destination coordinate expression cannot be empty": EXIT SUB
            coord_expr = getelements$(dst_start_list, coord_begin, coord_at - 1)
            IF coord_expr = "" THEN Give_Error "_ArrayCopy destination coordinate expression cannot be empty": EXIT SUB

            coord_count = coord_count + 1
            IF coord_count = 1 THEN first_coord = coord_expr

            IF compile_coords THEN
                coord_work = fixoperationorder$(coord_expr)
                IF Error_Happened THEN EXIT SUB
                coord_code = evaluatetotyp(coord_work, 64&)
                IF Error_Happened THEN EXIT SUB
                IF coord_init <> "" THEN coord_init = coord_init + ","
                coord_init = coord_init + "(int64)(" + coord_code + ")"
            END IF

            coord_begin = coord_at + 1
        END IF
    NEXT

    IF coord_depth <> 0 THEN Give_Error "_ArrayCopy destination coordinate expression has unmatched parentheses": EXIT SUB
    IF coord_count <> dst_dims THEN Give_Error "_ArrayCopy destination start coordinate count must match destination dimensions": EXIT SUB
END SUB


'Validate source() TO destination() for whole-array copies. One-dimensional
'arrays retain the existing index-preserving behavior. Multidimensional arrays
'must have the same declared dimension count; their runtime bounds are checked
'for exact equality before one contiguous block copy is allowed.
SUB CheckArrayCopyWholePair (src_type AS LONG, src_size AS LONG, src_dims AS LONG, dst_type AS LONG, dst_size AS LONG, dst_dims AS LONG, element_bytes AS LONG)
    element_bytes = 0
    IF src_dims <= 0 OR dst_dims <= 0 THEN
        Give_Error "_ArrayCopy cannot determine the array dimensions": EXIT SUB
    END IF
    IF src_dims <> dst_dims THEN
        Give_Error "_ArrayCopy whole-array source and destination must have the same number of dimensions": EXIT SUB
    END IF

    CheckArrayCopyElementPair src_type, src_size, dst_type, dst_size, element_bytes
END SUB

'Emit the fixed-size multidimensional range-copy tail shared by range-at and
'range-whole. Callers have already emitted descriptor validation, per-dimension
'bounds/count/offset calculation, and all local C variables used below. This helper
'only appends the identical stride/overflow/overlap/row-memmove sequence; it does
'not close the caller's outer generated C scope.

'Emit the fixed-size multidimensional range setup shared by range-to-start and
'range-to-whole. This block only declares the generated C working state and
'performs the initial descriptor/storage validity check; it deliberately does
'not open any generated control-flow block.
SUB AppendArrayCopyRangeNDFixedSetup (src_desc AS STRING, dst_desc AS STRING, src_dims AS LONG, dst_dims AS LONG)
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + src_desc + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dst_desc + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_total[" + _TOSTR$(src_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_total[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_count[" + _TOSTR$(src_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_offset[" + _TOSTR$(src_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_stride[" + _TOSTR$(src_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_stride[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_rows=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row_elements=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row_bytes=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_first_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_last_row_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last_row_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_first_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_last_end_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last_end_byte=0;"
    WriteBufLine MainTxtBuf, "int32 array_copy_backwards=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
END SUB



'Emit the fixed-size ND range bounds/count/offset loop. The caller supplies the
'generated C destination-coordinate expression for the current dimension.
'All generated if/for control flow is opened and closed inside this helper.
SUB AppendArrayCopyRangeNDFixedBounds (src_dims AS LONG, dst_coord_expr AS STRING)
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "ptrszint array_copy_arg=(" + _TOSTR$(src_dims) + "-1-array_copy_dim)*4+4;"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_lower=(int64)array_copy_src[array_copy_arg];"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_elements=(int64)array_copy_src[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[array_copy_arg];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_elements=(int64)array_copy_dst[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_elements<=0)||(array_copy_dst_elements<=0)||(array_copy_src_low[array_copy_dim]>array_copy_src_high[array_copy_dim])||(array_copy_src_low[array_copy_dim]<array_copy_src_lower)||(" + dst_coord_expr + "<array_copy_dst_lower)){error(9); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_total[array_copy_dim]=(uint64)array_copy_src_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_total[array_copy_dim]=(uint64)array_copy_dst_elements;"
    WriteBufLine MainTxtBuf, "array_copy_src_count[array_copy_dim]=(uint64)array_copy_src_high[array_copy_dim]-(uint64)array_copy_src_low[array_copy_dim]+1;"
    WriteBufLine MainTxtBuf, "array_copy_src_offset[array_copy_dim]=(uint64)array_copy_src_low[array_copy_dim]-(uint64)array_copy_src_lower;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset[array_copy_dim]=(uint64)" + dst_coord_expr + "-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src_count[array_copy_dim])||(array_copy_src_offset[array_copy_dim]>=array_copy_src_total[array_copy_dim])||(array_copy_src_count[array_copy_dim]>(array_copy_src_total[array_copy_dim]-array_copy_src_offset[array_copy_dim]))||(array_copy_dst_offset[array_copy_dim]>=array_copy_dst_total[array_copy_dim])||(array_copy_src_count[array_copy_dim]>(array_copy_dst_total[array_copy_dim]-array_copy_dst_offset[array_copy_dim]))){error(9); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB


SUB AppendArrayCopyRangeNDFixedTail (src_dims AS LONG, element_bytes AS LONG)
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_src_stride[0]=1;"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[0]=1;"
    WriteBufLine MainTxtBuf, "array_copy_row_elements=array_copy_src_count[0];"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_src_total[array_copy_dim-1]))||(array_copy_dst_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_dst_total[array_copy_dim-1]))||(array_copy_rows>(18446744073709551615ull/array_copy_src_count[array_copy_dim]))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_stride[array_copy_dim]=array_copy_src_stride[array_copy_dim-1]*array_copy_src_total[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[array_copy_dim]=array_copy_dst_stride[array_copy_dim-1]*array_copy_dst_total[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "array_copy_rows*=array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_offset[array_copy_dim]&&(array_copy_src_stride[array_copy_dim]>(18446744073709551615ull/array_copy_src_offset[array_copy_dim])))||(array_copy_dst_offset[array_copy_dim]&&(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_dst_offset[array_copy_dim])))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_term=array_copy_src_offset[array_copy_dim]*array_copy_src_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_term=array_copy_dst_offset[array_copy_dim]*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_first_element>(18446744073709551615ull-array_copy_src_term))||(array_copy_dst_first_element>(18446744073709551615ull-array_copy_dst_term))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_first_element+=array_copy_src_term;"
    WriteBufLine MainTxtBuf, "array_copy_dst_first_element+=array_copy_dst_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "array_copy_src_last_row_element=array_copy_src_first_element;"
    WriteBufLine MainTxtBuf, "array_copy_dst_last_row_element=array_copy_dst_first_element;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_ok&&array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_extra=array_copy_src_count[array_copy_dim]-1;"
    WriteBufLine MainTxtBuf, "if (array_copy_extra&&((array_copy_src_stride[array_copy_dim]>(18446744073709551615ull/array_copy_extra))||(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_extra)))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_term=array_copy_extra*array_copy_src_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_term=array_copy_extra*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_last_row_element>(18446744073709551615ull-array_copy_src_term))||(array_copy_dst_last_row_element>(18446744073709551615ull-array_copy_dst_term))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_last_row_element+=array_copy_src_term;"
    WriteBufLine MainTxtBuf, "array_copy_dst_last_row_element+=array_copy_dst_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "if (array_copy_row_elements>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_row_bytes=array_copy_row_elements*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_src_first_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_src_first_byte=array_copy_src_first_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_dst_first_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_dst_first_byte=array_copy_dst_first_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_src_last_row_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){uint64 array_copy_last_start=array_copy_src_last_row_element*(uint64)" + _TOSTR$(element_bytes) + "; if (array_copy_last_start>(18446744073709551615ull-array_copy_row_bytes)){error(257); array_copy_ok=0;} else array_copy_src_last_end_byte=array_copy_last_start+array_copy_row_bytes;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_dst_last_row_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){uint64 array_copy_last_start=array_copy_dst_last_row_element*(uint64)" + _TOSTR$(element_bytes) + "; if (array_copy_last_start>(18446744073709551615ull-array_copy_row_bytes)){error(257); array_copy_ok=0;} else array_copy_dst_last_end_byte=array_copy_last_start+array_copy_row_bytes;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "if ((array_copy_row_bytes>(uint64)(~(size_t)0))||(array_copy_src_first_byte>(uint64)(~(size_t)0))||(array_copy_dst_first_byte>(uint64)(~(size_t)0))||(array_copy_src_last_end_byte>(uint64)(~(size_t)0))||(array_copy_dst_last_end_byte>(uint64)(~(size_t)0))){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_addr=(uint64)array_copy_src[0];"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_addr=(uint64)array_copy_dst[0];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_addr>(18446744073709551615ull-array_copy_src_last_end_byte))||(array_copy_dst_addr>(18446744073709551615ull-array_copy_dst_last_end_byte))){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_first_addr=array_copy_src_addr+array_copy_src_first_byte;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_end=array_copy_src_addr+array_copy_src_last_end_byte;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_addr=array_copy_dst_addr+array_copy_dst_first_byte;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_end=array_copy_dst_addr+array_copy_dst_last_end_byte;"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_first_addr<array_copy_dst_end)&&(array_copy_dst_first_addr<array_copy_src_end)&&(array_copy_dst_first_addr>array_copy_src_first_addr)) array_copy_backwards=1;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_step=0; array_copy_step<array_copy_rows; array_copy_step++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row=array_copy_backwards?(array_copy_rows-1-array_copy_step):array_copy_step;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_quotient=array_copy_row;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_element=array_copy_src_first_element;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_element=array_copy_dst_first_element;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_coord=array_copy_quotient%array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_quotient/=array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_src_element+=array_copy_coord*array_copy_src_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_dst_element+=array_copy_coord*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_byte=array_copy_src_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_byte=array_copy_dst_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "memmove((void*)(((uint8*)array_copy_dst[0])+(size_t)array_copy_dst_byte),(void*)(((uint8*)array_copy_src[0])+(size_t)array_copy_src_byte),(size_t)array_copy_row_bytes);"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB



'Emit the copy tail shared by the two one-dimensional source-range forms after
'the caller has completed all form-specific bounds and offset preparation.
'Variable-length STRING uses the ownership-safe qbs snapshot path; fixed
'payloads retain the established overflow checks and memmove sequence.

'Emit the one-dimensional source-range descriptor/bounds/offset setup shared by
'range-to-start and range-to-whole forms. The caller supplies only the generated
'C expression used as the destination coordinate.
SUB AppendArrayCopyRange1DSetup (src_desc AS STRING, dst_desc AS STRING, dst_coord_expr AS STRING)
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + src_desc + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dst_desc + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_count=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_offset=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_bytes=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_src_low>array_copy_src_high)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_lower=(int64)array_copy_src[4];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[4];"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_total=(int64)array_copy_src[5];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_total=(int64)array_copy_dst[5];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_total<=0)||(array_copy_dst_total<=0)||(array_copy_src_low<array_copy_src_lower)||(" + dst_coord_expr + "<array_copy_dst_lower)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_count=(uint64)array_copy_src_high-(uint64)array_copy_src_low+1;"
    WriteBufLine MainTxtBuf, "array_copy_src_offset=(uint64)array_copy_src_low-(uint64)array_copy_src_lower;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset=(uint64)" + dst_coord_expr + "-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_count)||(array_copy_src_offset>=(uint64)array_copy_src_total)||(array_copy_dst_offset>=(uint64)array_copy_dst_total)||(array_copy_count>((uint64)array_copy_src_total-array_copy_src_offset))||(array_copy_count>((uint64)array_copy_dst_total-array_copy_dst_offset))){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB


SUB AppendArrayCopyRange1DTail (element_bytes AS LONG, var_string_copy AS LONG)
    IF var_string_copy THEN
        'A qbs** snapshot gives memmove-like overlap semantics without ever copying
        'the owning pointers themselves. Bounds and the temporary pointer-vector
        'size are validated before the first destination qbs_set.
        WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_count>((uint64)(~(size_t)0)/sizeof(qbs*)))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "qbs **array_copy_tmp=(qbs**)malloc((size_t)(array_copy_count*sizeof(qbs*)));"
        WriteBufLine MainTxtBuf, "uint64 array_copy_tmp_made=0;"
        WriteBufLine MainTxtBuf, "if ((!array_copy_tmp)&&array_copy_count){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_count;array_copy_i++){"
        WriteBufLine MainTxtBuf, "array_copy_tmp[array_copy_i]=qbs_new(0,0);"
        WriteBufLine MainTxtBuf, "if (array_copy_tmp[array_copy_i]) array_copy_tmp_made++;"
        WriteBufLine MainTxtBuf, "if ((!array_copy_tmp[array_copy_i])||is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "qbs_set(array_copy_tmp[array_copy_i],((qbs**)array_copy_src[0])[array_copy_src_offset+array_copy_i]);"
        WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_count;array_copy_i++){"
        WriteBufLine MainTxtBuf, "qbs_set(((qbs**)array_copy_dst[0])[array_copy_dst_offset+array_copy_i],array_copy_tmp[array_copy_i]);"
        WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_tmp_made;array_copy_i++) qbs_free(array_copy_tmp[array_copy_i]);"
        WriteBufLine MainTxtBuf, "free(array_copy_tmp);"
        WriteBufLine MainTxtBuf, "}"
    ELSE
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "if ((array_copy_count>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + "))||(array_copy_src_offset>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + "))||(array_copy_dst_offset>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + "))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "array_copy_bytes=array_copy_count*(uint64)" + _TOSTR$(element_bytes) + ";"
        WriteBufLine MainTxtBuf, "array_copy_src_byte=array_copy_src_offset*(uint64)" + _TOSTR$(element_bytes) + ";"
        WriteBufLine MainTxtBuf, "array_copy_dst_byte=array_copy_dst_offset*(uint64)" + _TOSTR$(element_bytes) + ";"
        WriteBufLine MainTxtBuf, "if ((array_copy_bytes>(uint64)(~(size_t)0))||(array_copy_src_byte>(uint64)(~(size_t)0))||(array_copy_dst_byte>(uint64)(~(size_t)0))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_bytes>0)){memmove((void*)(((uint8*)array_copy_dst[0])+(size_t)array_copy_dst_byte),(void*)(((uint8*)array_copy_src[0])+(size_t)array_copy_src_byte),(size_t)array_copy_bytes);}"
    END IF
END SUB



'Emit the copy tail shared by the two one-dimensional whole-source forms after
'the caller has completed its form-specific bounds and destination-offset setup.
'The helper owns only the common snapshot/byte-copy tail; form-specific bounds
'and destination-coordinate policy remain in the callers.
SUB AppendArrayCopyWhole1DTail (element_bytes AS LONG, var_string_copy AS LONG)
    IF var_string_copy THEN
        'Snapshot every source qbs before the first destination qbs_set.
        'All supported variable-length STRING arrays use native qbs* slots.
        WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_count>((uint64)(~(size_t)0)/sizeof(qbs*)))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "qbs **array_copy_tmp=(qbs**)malloc((size_t)(array_copy_count*sizeof(qbs*)));"
        WriteBufLine MainTxtBuf, "uint64 array_copy_tmp_made=0;"
        WriteBufLine MainTxtBuf, "if ((!array_copy_tmp)&&array_copy_count){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_count;array_copy_i++){"
        WriteBufLine MainTxtBuf, "array_copy_tmp[array_copy_i]=qbs_new(0,0);"
        WriteBufLine MainTxtBuf, "if (array_copy_tmp[array_copy_i]) array_copy_tmp_made++;"
        WriteBufLine MainTxtBuf, "if ((!array_copy_tmp[array_copy_i])||is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "qbs_set(array_copy_tmp[array_copy_i],((qbs**)array_copy_src[0])[array_copy_i]);"
        WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_count;array_copy_i++){"
        WriteBufLine MainTxtBuf, "qbs_set(((qbs**)array_copy_dst[0])[array_copy_dst_offset+array_copy_i],array_copy_tmp[array_copy_i]);"
        WriteBufLine MainTxtBuf, "if (is_error_pending()){array_copy_ok=0;break;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "for(uint64 array_copy_i=0;array_copy_i<array_copy_tmp_made;array_copy_i++) qbs_free(array_copy_tmp[array_copy_i]);"
        WriteBufLine MainTxtBuf, "free(array_copy_tmp);"
        WriteBufLine MainTxtBuf, "}"
    ELSE
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "if ((array_copy_count>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + "))||(array_copy_dst_offset>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + "))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok){"
        WriteBufLine MainTxtBuf, "array_copy_bytes=array_copy_count*(uint64)" + _TOSTR$(element_bytes) + ";"
        WriteBufLine MainTxtBuf, "array_copy_dst_byte=array_copy_dst_offset*(uint64)" + _TOSTR$(element_bytes) + ";"
        WriteBufLine MainTxtBuf, "if ((array_copy_bytes>(uint64)(~(size_t)0))||(array_copy_dst_byte>(uint64)(~(size_t)0))){error(257); array_copy_ok=0;}"
        WriteBufLine MainTxtBuf, "}"
        WriteBufLine MainTxtBuf, "if (array_copy_ok&&(array_copy_bytes>0)){memmove((void*)(((uint8*)array_copy_dst[0])+(size_t)array_copy_dst_byte),(void*)array_copy_src[0],(size_t)array_copy_bytes);}"
    END IF
END SUB


'Emit _ArrayCopy source(lower TO upper) TO destination(start). Numeric and
'fixed-length STRING arrays retain the byte-copy path. Variable-length STRING
'arrays use an ownership-safe qbs snapshot so overlap and self-copy are safe for
'top-level, inline/_Static, and descriptor-backed _Dynamic operands. All
'expressions and bounds are evaluated before copying.
SUB EmitArrayCopy1D (src_ref AS STRING, src_low_expr AS STRING, src_high_expr AS STRING, dst_ref AS STRING, dst_start_expr AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS STRING src_low_code, src_high_code, dst_start_code
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    CheckArrayCopy1DPair src_type, src_size, src_dims, src_string_slot_mode, dst_type, dst_size, dst_dims, dst_string_slot_mode, element_bytes, var_string_copy
    IF Error_Happened THEN EXIT SUB

    ParseArrayCopySourceRange1D src_low_expr, src_high_expr, src_low_code, src_high_code
    IF Error_Happened THEN EXIT SUB

    ParseArrayCopyDestinationStart1D dst_start_expr, dst_start_code
    IF Error_Happened THEN EXIT SUB
    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "int64 array_copy_src_low=(int64)(" + src_low_code + ");"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_high=(int64)(" + src_high_code + ");"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start=(int64)(" + dst_start_code + ");"
    AppendArrayCopyRange1DSetup src_desc, dst_desc, "array_copy_dst_start"
    AppendArrayCopyRange1DTail element_bytes, var_string_copy
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit _ArrayCopy source() TO destination(). One-dimensional arrays preserve
'their existing source indexes and may copy into a containing destination range.
'Multidimensional variable-length STRING arrays require matching dimension counts
'and exact runtime bounds. Member-involved copies use an ownership-safe qbs snapshot.
SUB EmitArrayCopyWholeND (src_ref AS STRING, dst_ref AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG src_var_string, dst_var_string, var_string_copy, member_var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    src_var_string = ArrayCopyIsVarString%(src_type)
    dst_var_string = ArrayCopyIsVarString%(dst_type)
    var_string_copy = 0
    member_var_string_copy = 0

    IF src_dims = 1 AND dst_dims = 1 THEN
        IF src_var_string OR dst_var_string THEN
            IF src_var_string = 0 OR dst_var_string = 0 THEN
                Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
            END IF
            IF src_string_slot_mode = 0 OR dst_string_slot_mode = 0 THEN
                Give_Error "_ArrayCopy cannot determine variable-length STRING storage": EXIT SUB
            END IF
            'All supported variable-length STRING operands use native qbs* slots.
            var_string_copy = -1
        ELSE
            CheckArrayCopyPair src_type, src_size, src_dims, dst_type, dst_size, dst_dims, element_bytes
        END IF
    ELSEIF src_var_string OR dst_var_string THEN
        IF src_var_string = 0 OR dst_var_string = 0 THEN
            Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
        END IF
        IF src_dims <= 1 OR dst_dims <= 1 OR src_dims <> dst_dims THEN
            Give_Error "_ArrayCopy whole-array source and destination must have the same number of dimensions": EXIT SUB
        END IF
        IF src_string_slot_mode = 0 OR dst_string_slot_mode = 0 THEN
            Give_Error "_ArrayCopy cannot determine variable-length STRING storage": EXIT SUB
        END IF
        'Any member-involved pair is copied through a complete ownership-safe snapshot.
        var_string_copy = -1
        IF INSTR(src_ref, ".") OR INSTR(dst_ref, ".") THEN member_var_string_copy = -1
    ELSE
        CheckArrayCopyWholePair src_type, src_size, src_dims, dst_type, dst_size, dst_dims, element_bytes
    END IF
    IF Error_Happened THEN EXIT SUB

    IF src_dims > 1 THEN
        IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
        IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
        IF member_var_string_copy THEN
            AppendArrayCopyWholeVarString dst_desc, src_desc, src_dims, dst_string_slot_mode, src_string_slot_mode
        ELSE
            AppendWholeArrayAssign dst_desc, src_desc, src_type, src_size, src_dims, 0, 0
        END IF
        EXIT SUB
    END IF

    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + src_desc + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dst_desc + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_count=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_bytes=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_lower=(int64)array_copy_src[4];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[4];"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_total=(int64)array_copy_src[5];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_total=(int64)array_copy_dst[5];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_total<=0)||(array_copy_dst_total<=0)||(array_copy_src_lower<array_copy_dst_lower)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_count=(uint64)array_copy_src_total;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset=(uint64)array_copy_src_lower-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((array_copy_dst_offset>=(uint64)array_copy_dst_total)||(array_copy_count>((uint64)array_copy_dst_total-array_copy_dst_offset))){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    AppendArrayCopyWhole1DTail element_bytes, var_string_copy
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit _ArrayCopy source() TO destination(start1, start2, ...). The source and
'destination must have the same number of dimensions and compatible element types.
'One-dimensional variable-length STRING pairs use EmitArrayCopyWholeAt1D.
'Multidimensional variable-length STRING pairs use a complete ownership-safe qbs
'snapshot. Fixed-size payloads keep the established row-wise memmove path. All
'expressions, descriptor states, bounds and overflow checks complete before writes.
SUB EmitArrayCopyWholeAtND (src_ref AS STRING, dst_ref AS STRING, dst_start_list AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS STRING coord_init, first_coord
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG src_var_string, dst_var_string, defer_var_string_1d, var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    src_var_string = ArrayCopyIsVarString%(src_type)
    dst_var_string = ArrayCopyIsVarString%(dst_type)
    defer_var_string_1d = 0
    var_string_copy = 0
    IF src_var_string OR dst_var_string THEN
        IF src_var_string = 0 OR dst_var_string = 0 THEN
            Give_Error "_ArrayCopy requires arrays with the same element type": EXIT SUB
        END IF
        IF src_dims = 1 AND dst_dims = 1 THEN
            defer_var_string_1d = -1
        ELSE
            IF src_dims <= 1 OR dst_dims <= 1 OR src_dims <> dst_dims THEN
                Give_Error "_ArrayCopy whole-array source and destination must have the same number of dimensions": EXIT SUB
            END IF
            IF src_string_slot_mode = 0 OR dst_string_slot_mode = 0 THEN
                Give_Error "_ArrayCopy cannot determine variable-length STRING storage": EXIT SUB
            END IF
            var_string_copy = -1
        END IF
    ELSE
        CheckArrayCopyWholePair src_type, src_size, src_dims, dst_type, dst_size, dst_dims, element_bytes
        IF Error_Happened THEN EXIT SUB
    END IF

    ParseArrayCopyDestinationStarts dst_start_list, dst_dims, (src_dims > 1), coord_init, first_coord
    IF Error_Happened THEN EXIT SUB

    IF src_dims = 1 THEN
        EmitArrayCopyWholeAt1D src_ref, dst_ref, first_coord
        EXIT SUB
    END IF

    IF var_string_copy THEN
        WriteBufLine MainTxtBuf, "{"
        IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
        IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
        AppendArrayCopyWholeAtVarString dst_desc, src_desc, src_dims, coord_init, dst_string_slot_mode, src_string_slot_mode
        IF Error_Happened THEN EXIT SUB
        WriteBufLine MainTxtBuf, "}"
        EXIT SUB
    END IF

    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start[" + _TOSTR$(dst_dims) + "]={" + coord_init + "};"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + src_desc + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dst_desc + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_count[" + _TOSTR$(src_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_count[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_stride[" + _TOSTR$(dst_dims) + "]={0};"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_rows=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row_elements=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row_bytes=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_bytes=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last_row_element=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_last_end_byte=0;"
    WriteBufLine MainTxtBuf, "int32 array_copy_backwards=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "ptrszint array_copy_arg=(" + _TOSTR$(src_dims) + "-1-array_copy_dim)*4+4;"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_elements=(int64)array_copy_src[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_elements=(int64)array_copy_dst[array_copy_arg+1];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[array_copy_arg];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_elements<=0)||(array_copy_dst_elements<=0)||(array_copy_dst_start[array_copy_dim]<array_copy_dst_lower)){error(9); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_count[array_copy_dim]=(uint64)array_copy_src_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_count[array_copy_dim]=(uint64)array_copy_dst_elements;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset[array_copy_dim]=(uint64)array_copy_dst_start[array_copy_dim]-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((array_copy_dst_offset[array_copy_dim]>=array_copy_dst_count[array_copy_dim])||(array_copy_src_count[array_copy_dim]>(array_copy_dst_count[array_copy_dim]-array_copy_dst_offset[array_copy_dim]))){error(9); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[0]=1;"
    WriteBufLine MainTxtBuf, "array_copy_row_elements=array_copy_src_count[0];"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_stride[array_copy_dim-1]>(18446744073709551615ull/array_copy_dst_count[array_copy_dim-1])){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_stride[array_copy_dim]=array_copy_dst_stride[array_copy_dim-1]*array_copy_dst_count[array_copy_dim-1];"
    WriteBufLine MainTxtBuf, "if (array_copy_src_rows>(18446744073709551615ull/array_copy_src_count[array_copy_dim])){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_src_rows*=array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=0; array_copy_dim<" + _TOSTR$(dst_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_offset[array_copy_dim]&&(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_dst_offset[array_copy_dim]))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_term=array_copy_dst_offset[array_copy_dim]*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_first_element>(18446744073709551615ull-array_copy_term)){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_first_element+=array_copy_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "array_copy_dst_last_row_element=array_copy_dst_first_element;"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_ok&&array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_extra=array_copy_src_count[array_copy_dim]-1;"
    WriteBufLine MainTxtBuf, "if (array_copy_extra&&(array_copy_dst_stride[array_copy_dim]>(18446744073709551615ull/array_copy_extra))){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_term=array_copy_extra*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "if (array_copy_dst_last_row_element>(18446744073709551615ull-array_copy_term)){error(257); array_copy_ok=0; break;}"
    WriteBufLine MainTxtBuf, "array_copy_dst_last_row_element+=array_copy_term;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "if (array_copy_row_elements>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_row_bytes=array_copy_row_elements*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_src_rows&&(array_copy_row_bytes>(18446744073709551615ull/array_copy_src_rows))){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_src_bytes=array_copy_src_rows*array_copy_row_bytes;"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_dst_first_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok) array_copy_dst_first_byte=array_copy_dst_first_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_ok&&array_copy_dst_last_row_element>(18446744073709551615ull/(uint64)" + _TOSTR$(element_bytes) + ")){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_last_start=array_copy_dst_last_row_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "if (array_copy_last_start>(18446744073709551615ull-array_copy_row_bytes)){error(257); array_copy_ok=0;} else array_copy_dst_last_end_byte=array_copy_last_start+array_copy_row_bytes;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "if ((array_copy_row_bytes>(uint64)(~(size_t)0))||(array_copy_src_bytes>(uint64)(~(size_t)0))||(array_copy_dst_first_byte>(uint64)(~(size_t)0))||(array_copy_dst_last_end_byte>(uint64)(~(size_t)0))){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_addr=(uint64)array_copy_src[0];"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_addr=(uint64)array_copy_dst[0];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_addr>(18446744073709551615ull-array_copy_src_bytes))||(array_copy_dst_addr>(18446744073709551615ull-array_copy_dst_last_end_byte))){error(257); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_end=array_copy_src_addr+array_copy_src_bytes;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_first_addr=array_copy_dst_addr+array_copy_dst_first_byte;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_end=array_copy_dst_addr+array_copy_dst_last_end_byte;"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_addr<array_copy_dst_end)&&(array_copy_dst_first_addr<array_copy_src_end)&&(array_copy_dst_first_addr>array_copy_src_addr)) array_copy_backwards=1;"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "for(uint64 array_copy_step=0; array_copy_step<array_copy_src_rows; array_copy_step++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_row=array_copy_backwards?(array_copy_src_rows-1-array_copy_step):array_copy_step;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_quotient=array_copy_row;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_element=array_copy_dst_offset[0];"
    WriteBufLine MainTxtBuf, "for(ptrszint array_copy_dim=1; array_copy_dim<" + _TOSTR$(src_dims) + "; array_copy_dim++){"
    WriteBufLine MainTxtBuf, "uint64 array_copy_coord=array_copy_quotient%array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_quotient/=array_copy_src_count[array_copy_dim];"
    WriteBufLine MainTxtBuf, "array_copy_dst_element+=(array_copy_dst_offset[array_copy_dim]+array_copy_coord)*array_copy_dst_stride[array_copy_dim];"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "uint64 array_copy_src_byte=array_copy_row*array_copy_row_bytes;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_byte=array_copy_dst_element*(uint64)" + _TOSTR$(element_bytes) + ";"
    WriteBufLine MainTxtBuf, "memmove((void*)(((uint8*)array_copy_dst[0])+(size_t)array_copy_dst_byte),(void*)(((uint8*)array_copy_src[0])+(size_t)array_copy_src_byte),(size_t)array_copy_row_bytes);"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
END SUB



'Emit _ArrayCopy source(lower1 TO upper1, lower2 TO upper2, ...) TO
'destination(start1, start2, ...). The source and destination must have the same
'number of dimensions and compatible element types. Variable-length STRING arrays
'use a complete ownership-safe qbs snapshot; fixed-size payloads keep the row-wise
'memmove path. All expressions, descriptor states, bounds and overflow conditions
'are checked before any destination write.
SUB EmitArrayCopyRangeAtND (src_ref AS STRING, src_range_list AS STRING, dst_ref AS STRING, dst_start_list AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS STRING low_init, high_init
    DIM AS STRING coord_init, first_coord
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    CheckArrayCopyRangeNDPair src_type, src_size, src_dims, src_string_slot_mode, dst_type, dst_size, dst_dims, dst_string_slot_mode, element_bytes, var_string_copy
    IF Error_Happened THEN EXIT SUB

    IF src_dims <= 1 THEN
        Give_Error "_ArrayCopy multidimensional source ranges require at least two dimensions"
        EXIT SUB
    END IF

    ParseArrayCopySourceRanges src_range_list, src_dims, low_init, high_init
    IF Error_Happened THEN EXIT SUB

    ParseArrayCopyDestinationStarts dst_start_list, dst_dims, -1, coord_init, first_coord
    IF Error_Happened THEN EXIT SUB

    IF var_string_copy THEN
        WriteBufLine MainTxtBuf, "{"
        IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
        IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
        AppendArrayCopyRangeAtVarString dst_desc, src_desc, src_dims, low_init, high_init, coord_init, dst_string_slot_mode, src_string_slot_mode
        IF Error_Happened THEN EXIT SUB
        WriteBufLine MainTxtBuf, "}"
        EXIT SUB
    END IF

    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "int64 array_copy_src_low[" + _TOSTR$(src_dims) + "]={" + low_init + "};"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_high[" + _TOSTR$(src_dims) + "]={" + high_init + "};"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start[" + _TOSTR$(dst_dims) + "]={" + coord_init + "};"
    AppendArrayCopyRangeNDFixedSetup src_desc, dst_desc, src_dims, dst_dims
    AppendArrayCopyRangeNDFixedBounds src_dims, "array_copy_dst_start[array_copy_dim]"
    AppendArrayCopyRangeNDFixedTail src_dims, element_bytes
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit _ArrayCopy source(lower1 TO upper1, ...) TO destination(). The
'selected source coordinates are preserved in the destination, so every source
'range must fit inside the destination at the same index values. Variable-length
'STRING arrays use a complete ownership-safe qbs snapshot; fixed-size payloads
'retain row-wise memmove. Every expression, descriptor state, bound and overflow
'condition is checked before the first destination write.
SUB EmitArrayCopyRangeWholeND (src_ref AS STRING, src_range_list AS STRING, dst_ref AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS STRING low_init, high_init, preserve_init
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG preserve_dim
    DIM AS LONG var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    CheckArrayCopyRangeNDPair src_type, src_size, src_dims, src_string_slot_mode, dst_type, dst_size, dst_dims, dst_string_slot_mode, element_bytes, var_string_copy
    IF Error_Happened THEN EXIT SUB

    IF src_dims <= 1 THEN
        Give_Error "_ArrayCopy multidimensional source ranges require at least two dimensions"
        EXIT SUB
    END IF

    ParseArrayCopySourceRanges src_range_list, src_dims, low_init, high_init
    IF Error_Happened THEN EXIT SUB

    'For preserve-coordinate semantics the destination start in every dimension
    'is the already-evaluated source lower bound. Referencing array_copy_src_low
    'inside the following C initializer avoids evaluating any BASIC expression a
    'second time while reusing the range-to-start snapshot implementation.
    preserve_init = ""
    FOR preserve_dim = 0 TO src_dims - 1
        IF preserve_init <> "" THEN preserve_init = preserve_init + ","
        preserve_init = preserve_init + "array_copy_src_low[" + _TOSTR$(preserve_dim) + "]"
    NEXT

    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    IF var_string_copy THEN
        AppendArrayCopyRangeAtVarString dst_desc, src_desc, src_dims, low_init, high_init, preserve_init, dst_string_slot_mode, src_string_slot_mode
        WriteBufLine MainTxtBuf, "}"
        EXIT SUB
    END IF
    WriteBufLine MainTxtBuf, "int64 array_copy_src_low[" + _TOSTR$(src_dims) + "]={" + low_init + "};"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_high[" + _TOSTR$(src_dims) + "]={" + high_init + "};"
    AppendArrayCopyRangeNDFixedSetup src_desc, dst_desc, src_dims, dst_dims
    AppendArrayCopyRangeNDFixedBounds src_dims, "array_copy_src_low[array_copy_dim]"
    AppendArrayCopyRangeNDFixedTail src_dims, element_bytes
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit _ArrayCopy source() TO destination(start), copying the complete source
'in physical element order beginning at the requested destination index. Numeric
'and fixed-length STRING arrays retain memmove. Variable-length STRING operands use
'an ownership-safe qbs snapshot. All checks finish before any destination changes.
SUB EmitArrayCopyWholeAt1D (src_ref AS STRING, dst_ref AS STRING, dst_start_expr AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM dst_start_code AS STRING
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB

    CheckArrayCopy1DPair src_type, src_size, src_dims, src_string_slot_mode, dst_type, dst_size, dst_dims, dst_string_slot_mode, element_bytes, var_string_copy
    IF Error_Happened THEN EXIT SUB

    ParseArrayCopyDestinationStart1D dst_start_expr, dst_start_code
    IF Error_Happened THEN EXIT SUB
    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_start=(int64)(" + dst_start_code + ");"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_src=" + src_desc + ";"
    WriteBufLine MainTxtBuf, "ptrszint *array_copy_dst=" + dst_desc + ";"
    WriteBufLine MainTxtBuf, "int32 array_copy_ok=1;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_count=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_offset=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_dst_byte=0;"
    WriteBufLine MainTxtBuf, "uint64 array_copy_bytes=0;"
    WriteBufLine MainTxtBuf, "if ((!array_copy_src)||(!array_copy_dst)||!(array_copy_src[2]&1)||!(array_copy_dst[2]&1)||(!array_copy_src[0])||(!array_copy_dst[0])||(array_copy_src[0]==(ptrszint)nothingvalue)||(array_copy_dst[0]==(ptrszint)nothingvalue)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_lower=(int64)array_copy_dst[4];"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_total=(int64)array_copy_src[5];"
    WriteBufLine MainTxtBuf, "int64 array_copy_dst_total=(int64)array_copy_dst[5];"
    WriteBufLine MainTxtBuf, "if ((array_copy_src_total<=0)||(array_copy_dst_total<=0)||(array_copy_dst_start<array_copy_dst_lower)){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "if (array_copy_ok){"
    WriteBufLine MainTxtBuf, "array_copy_count=(uint64)array_copy_src_total;"
    WriteBufLine MainTxtBuf, "array_copy_dst_offset=(uint64)array_copy_dst_start-(uint64)array_copy_dst_lower;"
    WriteBufLine MainTxtBuf, "if ((array_copy_dst_offset>=(uint64)array_copy_dst_total)||(array_copy_count>((uint64)array_copy_dst_total-array_copy_dst_offset))){error(9); array_copy_ok=0;}"
    WriteBufLine MainTxtBuf, "}"
    WriteBufLine MainTxtBuf, "}"
    AppendArrayCopyWhole1DTail element_bytes, var_string_copy
    WriteBufLine MainTxtBuf, "}"
END SUB


'Emit _ArrayCopy source(lower TO upper) TO destination(), preserving the
'actual source index values in the destination. The destination must contain
'the complete requested source interval. Variable-length STRING operands use an
'ownership-safe qbs snapshot.
SUB EmitArrayCopyRangeWhole1D (src_ref AS STRING, src_low_expr AS STRING, src_high_expr AS STRING, dst_ref AS STRING)
    DIM AS STRING src_desc, dst_desc, src_prep, dst_prep
    DIM AS STRING src_low_code, src_high_code
    DIM AS LONG src_type, dst_type, src_size, dst_size, src_dims, dst_dims, element_bytes
    DIM AS LONG var_string_copy
    DIM AS LONG src_string_slot_mode, dst_string_slot_mode

    ResolveArrayCopyPairEx src_ref, dst_ref, src_desc, src_prep, src_type, src_size, src_dims, src_string_slot_mode, dst_desc, dst_prep, dst_type, dst_size, dst_dims, dst_string_slot_mode
    IF Error_Happened THEN EXIT SUB
    CheckArrayCopy1DPair src_type, src_size, src_dims, src_string_slot_mode, dst_type, dst_size, dst_dims, dst_string_slot_mode, element_bytes, var_string_copy
    IF Error_Happened THEN EXIT SUB

    ParseArrayCopySourceRange1D src_low_expr, src_high_expr, src_low_code, src_high_code
    IF Error_Happened THEN EXIT SUB
    WriteBufLine MainTxtBuf, "{"
    IF src_prep <> "" THEN WriteBufRawData MainTxtBuf, src_prep
    IF dst_prep <> "" THEN WriteBufRawData MainTxtBuf, dst_prep
    WriteBufLine MainTxtBuf, "int64 array_copy_src_low=(int64)(" + src_low_code + ");"
    WriteBufLine MainTxtBuf, "int64 array_copy_src_high=(int64)(" + src_high_code + ");"
    AppendArrayCopyRange1DSetup src_desc, dst_desc, "array_copy_src_low"
    AppendArrayCopyRange1DTail element_bytes, var_string_copy
    WriteBufLine MainTxtBuf, "}"
END SUB
