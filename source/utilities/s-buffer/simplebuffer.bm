'| ##     ##   # |                            ._.'                   |
'| ##     ###### |  Sources & Documents placed in the Public Domain. |
'+---------------+---------------------------------------------------+
'|                                                                   |
'| === simplebuffer.bm ===                                           |
'|                                                                   |
'| == Simple string array based buffer system for your storage needs.|
'|                                                                   |
'+-------------------------------------------------------------------+
'| Done by RhoSigma, R.Heyder, provided AS IS, use at your own risk. |
'| Find me in the QB64 Forum or mail to support@rhosigma-cw.net for  |
'| any questions or suggestions. Thanx for your interest in my work. |
'+-------------------------------------------------------------------+

'--- docs\CreateBuf.html
'---------------------------------------------------------------------
FUNCTION CreateBuf%
    '--- option _explicit requirements ---
    DIM aub&, buf&, idx%, bufs&, newBufs&

    aub& = UBOUND(simplebuffer_array$)
    buf& = simplebuffer_freeHint&: CreateBuf% = SBE_NoMoreBuffers
    IF buf& < 0 THEN buf& = 0
    WHILE buf& < aub&
        IF LEN(simplebuffer_array$(buf& + 1)) = 0 THEN EXIT WHILE
        buf& = buf& + simplebuffer_slots
        IF buf& >= 32765 * simplebuffer_slots THEN EXIT FUNCTION '=> allow max. 32765 buffers
    WEND

    simplebuffer_freeHint& = buf& + simplebuffer_slots
    IF buf& > simplebuffer_topUsed& THEN simplebuffer_topUsed& = buf&

    '--- expand array, if necessary ---
    IF aub& < buf& + simplebuffer_slots - 1 THEN
        ' We add half the number of buffers each time, it's cheaper to overshoot
        ' when there's a large number of buffers being used rather than keep
        ' adding a fixed number.
        bufs& = (aub& + 1) \ simplebuffer_slots
        newBufs& = bufs& + bufs& \ 2
        IF newBufs& < (buf& \ simplebuffer_slots) + 100 THEN newBufs& = (buf& \ simplebuffer_slots) + 100 '=> at least 100 more buffers
        IF newBufs& > 32766 THEN newBufs& = 32766
        REDIM _PRESERVE simplebuffer_array$(0 TO newBufs& * simplebuffer_slots - 1)
    END IF
    '--- init buffer ---
    simplebuffer_array$(buf& + 0) = SPACE$(16384) '                        => the actual buffer (will grow as needed)
    simplebuffer_array$(buf& + 1) = MKL$(1) + MKL$(0) + "EolU" + MKL$(-1) '=> cursor position + buffer length + EOL mode + change state
    '--- return new handle ---
    CreateBuf% = buf& \ simplebuffer_slots
END FUNCTION

'--- docs\DisposeBuf.html
'---------------------------------------------------------------------
SUB DisposeBuf (handle%)
    '--- option _explicit requirements ---
    DIM buf&, idx%, aub&, usedBufs&, keepBufs&
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- erase buffer data ---
    FOR idx% = 0 TO simplebuffer_slots - 1
        simplebuffer_array$(buf& + idx%) = ""
    NEXT idx%
    '--- update bookkeeping ---
    IF buf& < simplebuffer_freeHint& THEN simplebuffer_freeHint& = buf&

    ' Consider if we can shrink the array, we can only remove from the end of
    ' the array so if topUsed is after us then there's still buffers sitting in
    ' that area.
    IF buf& < simplebuffer_topUsed& THEN EXIT SUB
    aub& = UBOUND(simplebuffer_array$)
    buf& = simplebuffer_topUsed&
    IF buf& > aub& - simplebuffer_slots + 1 THEN buf& = aub& - simplebuffer_slots + 1
    WHILE buf& >= 0
        IF LEN(simplebuffer_array$(buf& + 1)) THEN EXIT WHILE
        buf& = buf& - simplebuffer_slots
    WEND
    simplebuffer_topUsed& = buf&

    ' Mirrors CreateBuf and only reduces the number of buffers if it would halve the
    ' current count.
    usedBufs& = (buf& + simplebuffer_slots) \ simplebuffer_slots
    keepBufs& = usedBufs& + usedBufs& \ 2 + 10
    IF keepBufs& < ((aub& + 1) \ simplebuffer_slots) \ 2 THEN
        REDIM _PRESERVE simplebuffer_array$(0 TO keepBufs& * simplebuffer_slots - 1)
        IF simplebuffer_freeHint& > keepBufs& * simplebuffer_slots THEN simplebuffer_freeHint& = keepBufs& * simplebuffer_slots
    END IF
END SUB

'--- docs\FileToBuf.html
'---------------------------------------------------------------------
FUNCTION FileToBuf% (fileSpec$)
    '--- option _explicit requirements ---
    DIM han%, buf&, ff%, fl&&, ext&
    '--- create a new buffer ---
    han% = CreateBuf%
    buf& = han% * simplebuffer_slots
    '--- on success, open file ---
    IF han% >= 0 THEN
        ff% = FREEFILE
        OPEN fileSpec$ FOR BINARY LOCK WRITE AS ff%
        fl&& = LOF(ff%): ext& = fl&& MOD 16384
        '--- check file length ---
        IF fl&& > &H40000000&& THEN
            ERROR 7 'buffer overflow (file too big, >1GiB)
            'If the program is continued from here regardless of the error,
            'then the returned buffer will be empty, but ready to use.
        ELSE
            '--- load file into buffer & adjust length ---
            simplebuffer_array$(buf& + 0) = SPACE$(fl&&)
            GET ff%, , simplebuffer_array$(buf& + 0)
            IF ext& > 0 THEN
                simplebuffer_array$(buf& + 0) = simplebuffer_array$(buf& + 0) + SPACE$(16384 - ext&)
            END IF
            '--- set cursor, buffer length & change state ---
            MID$(simplebuffer_array$(buf& + 1), 1, 4) = MKL$(1)
            MID$(simplebuffer_array$(buf& + 1), 5, 4) = MKL$(fl&&)
            MID$(simplebuffer_array$(buf& + 1), 13, 4) = MKL$(0)
        END IF
        CLOSE ff%
    END IF
    '--- return new handle ---
    FileToBuf% = han%
END FUNCTION

'--- docs\BufToFile.html
'---------------------------------------------------------------------
SUB BufToFile (handle%, fileSpec$)
    '--- option _explicit requirements ---
    DIM buf&, ff%, dat$
    '--- check handle ---
    IF NOT CheckHandle%(handle%) THEN ERROR 258: STOP 'invalid handle
    buf& = handle% * simplebuffer_slots
    '--- write file (overwrite existing !!!) ---
    ff% = FREEFILE: dat$ = LEFT$(simplebuffer_array$(buf& + 0), GetBufLen&(handle%))
    OPEN fileSpec$ FOR OUTPUT LOCK WRITE AS ff%: CLOSE ff%
    OPEN fileSpec$ FOR BINARY LOCK WRITE AS ff%
    PUT ff%, , dat$
    CLOSE ff%
    '--- reset change state ---
    MID$(simplebuffer_array$(buf& + 1), 13, 4) = MKL$(0)
END SUB

